# Storyblok Delivery API (Content Delivery) — hemmelig; kopier til .env og fyll inn.
# https://www.storyblok.com/docs/api/content-delivery
STORYBLOK_DELIVERY_API_TOKEN=

# CES headless (#125M-B) — server-side only; sett i Vercel env, aldri i client bundle.
# CES_APP_ID = CES channel / runSession (ces.googleapis.com/.../apps/...) — IKKE Discovery Engine engine ID.
CES_PROJECT_ID=hearing-aid-mvp
CES_LOCATION=eu
CES_APP_ID=1741e68d-0528-4625-8b83-99a0dbb5298f
CES_APP_VERSION_ID=91cc4831-f020-4bb1-a17c-650859401cb1
CES_DEPLOYMENT_ID=edb2938a-a2bf-4555-b4c9-d54963531db4
GOOGLE_SERVICE_ACCOUNT_JSON=

# Agent Search direct :answer (#198) — Discovery Engine engines/{id} — MUST differ from CES_APP_ID.
# Known-good preview: h-rehjelpen-v1-2_1771939983615 (app Hørehjelpen v1.2, Search, store HearingNorwaystore).
# Docs: docs/project/GOOGLE_AGENT_SEARCH_DIRECT_KNOWN_GOOD_v0_1.md
AGENT_SEARCH_ENGINE_ID=
# Valgfri override (default default_serving_config for :answer).
# AGENT_SEARCH_SERVING_CONFIG=default_serving_config
# :answer session — omit (default) eller full resource path …/sessions/-
# AGENT_SEARCH_ANSWER_SESSION=omit
# AGENT_SEARCH_ANSWER_SESSION=full

# AI backend mode (#198) — default ces_channel if unset. Do not set google_agent_search_direct in Production until reliability QA passes.
# VIDDEL_AI_BACKEND=ces_channel
# VIDDEL_AI_BACKEND=google_agent_search_direct

# Public AI rate limiting (#180 v0.2) lives in Vercel Firewall, not environment variables.
# Required before merging/removing the legacy Upstash guard:
# - /api/chat: IP-based rate-limit rule returning HTTP 429
# - /api/image-vision: separate, stricter IP-based rate-limit rule returning HTTP 429

# Temporary owner control for public AI (#180) — server-side only, never PUBLIC_ prefix.
# PIN is exactly four digits. Session token must be at least 32 random base64url/hex characters.
# Public access is controlled by the Boolean Vercel Flag `public-ai-enabled`.
# Vercel Flags authenticates with Vercel's system OIDC identity; no management token is stored in the app.
# VIDDEL_OWNER_PIN=
# VIDDEL_OWNER_SESSION_TOKEN=

# Ops reliability testing (#188 guard v0.2) — server-only, NEVER PUBLIC_ prefix, never in frontend.
# A matching header exposes safe response metadata; it does not bypass Vercel Firewall.
# Used by npm run chat:reliability only — not exposed to users.
VIDDEL_OPS_TEST_TOKEN=

# PostHog EU (#188) — optional public keys for client-side product events only.
# No session replay, no user profiles, no message content.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Viddel Lab (#237) — shared password for /lab/* and /api/lab/*.
# Preview/local: VIDDEL_LAB_PASSWORD + VIDDEL_LAB_COOKIE_SECRET.
# Production: also set VIDDEL_LAB_PUBLIC_ENABLED=true (explicit opt-in only).
# VIDDEL_LAB_PASSWORD=
# VIDDEL_LAB_COOKIE_SECRET=
# VIDDEL_LAB_PUBLIC_ENABLED=true

# Lab image QA — Vertex vision + optional /api/chat chain (set in Vercel Preview with Lab vars above).
# GOOGLE_SERVICE_ACCOUNT_JSON= (same as CES)
# CES_PROJECT_ID= CES_LOCATION= CES_APP_ID= CES_APP_VERSION_ID= CES_DEPLOYMENT_ID=
# IMAGE_VISION_PROBE_MODEL=gemini-2.5-flash
