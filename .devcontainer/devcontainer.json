{
  "name": "Viddel cloud fallback",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Viddel Astro dev",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
