---
/* Preview-only decision gate for #121. All derivatives reuse locked canonical geometry. */
const base = import.meta.env.BASE_URL;

const wordmarks = [
  { id: "primary", label: "Primary", detail: "5 stolper · fra 22 px", width: 937.88, height: 134, renderHeight: 32 },
  { id: "small", label: "Small Y", detail: "5 stolper · 18–20 px", width: 140, height: 20, renderHeight: 20 },
  { id: "micro", label: "Micro A", detail: "3 stolper · 8–16 px", width: 140, height: 20, renderHeight: 16 },
];

const treatments = [
  { id: "default", label: "Default", detail: "Navy + blue · godkjent", dark: false },
  { id: "mono-navy", label: "Mono dark", detail: "Alt i navy · godkjent", dark: false },
  { id: "inverse-blue", label: "Inverse", detail: "Hvit + blue · godkjent", dark: true },
  { id: "mono-white", label: "Mono white", detail: "Alt i hvitt · godkjent", dark: true },
];

const wordmarkSrc = (wordmark: (typeof wordmarks)[number], treatment: (typeof treatments)[number]) =>
  treatment.id === "default"
    ? `${base}brand/viddel-wordmark-${wordmark.id}-${wordmark.id === "micro" ? "3bar" : "5bar"}.svg`
    : `${base}brand/viddel-wordmark-${wordmark.id}-${wordmark.id === "micro" ? "3bar" : "5bar"}-${treatment.id}.svg`;

const signals = [
  { id: "primary", bars: "5bar", label: "Primary 5-bar", detail: "prioritet 20–32 px", aspect: 108.57 / 93.73 },
  { id: "small", bars: "5bar", label: "Small 5-bar", detail: "prioritet 8–16 px", aspect: 18 / 16.7414 },
  { id: "micro", bars: "3bar", label: "Micro 3-bar", detail: "8 px · krevende tilfeller", aspect: 10 / 16.7414 },
];
const signalSizes = [8, 12, 16, 20, 24, 32];
const faviconBars = [{ x: 1, height: 2 }, { x: 4, height: 6 }, { x: 7, height: 10 }, { x: 10, height: 6 }, { x: 13, height: 2 }];
const faviconVariants = [
  {
    id: "micro5-green",
    label: "Signal green / white",
    status: "Låst produksjonsvalg",
    background: "#159a62",
    signal: "#ffffff",
    fillWidth: 15,
    bars: faviconBars,
  },
  {
    id: "micro5-blue",
    label: "Clear blue / white",
    status: "Dokumentert modningsalternativ",
    background: "#3672e6",
    signal: "#ffffff",
    fillWidth: 15,
    bars: faviconBars,
  },
];
const neighborMarks = [
  { mark: "A", color: "#111827", background: "#ffffff", shape: "square" },
  { mark: "✦", color: "#ffffff", background: "#ea4335", shape: "round" },
  { mark: "G", color: "#ffffff", background: "#4285f4", shape: "round" },
  { mark: "●", color: "#111827", background: "#ffffff", shape: "square" },
  { mark: "N", color: "#ffffff", background: "#ef4444", shape: "round" },
  { mark: "◆", color: "#ffffff", background: "#7c3aed", shape: "square" },
  { mark: "M", color: "#ffffff", background: "#111827", shape: "round" },
  { mark: "+", color: "#ffffff", background: "#10b981", shape: "square" },
];
---

<section class="brand-review" aria-labelledby="brand-review-heading">
  <header class="brand-review__head">
    <div>
      <p>#121 · godkjent assetgrunnlag</p>
      <h2 id="brand-review-heading">Fargebehandlinger og standalone-signal</h2>
    </div>
    <p>
      Geometrien, fargebehandlingene og størrelsesrollene er nå godkjent. Alle avledninger bruker
      samme punkter, proporsjoner og mellomrom som sine canonical wordmarks.
    </p>
  </header>

  <div class="brand-review__matrix" aria-label="Wordmark-fargebehandlinger">
    {wordmarks.map((wordmark) => (
      <article class="wordmark-row">
        <header>
          <strong>{wordmark.label}</strong>
          <span>{wordmark.detail}</span>
        </header>
        <div class="wordmark-row__treatments">
          {treatments.map((treatment) => (
            <figure class:list={["treatment", treatment.dark && "treatment--dark"]}>
              <div class="treatment__stage">
                <img
                  src={wordmarkSrc(wordmark, treatment)}
                  alt={`VIDDEL ${wordmark.label}, ${treatment.detail}`}
                  width={wordmark.width}
                  height={wordmark.height}
                  style={`height: ${wordmark.renderHeight}px`}
                />
              </div>
              <figcaption><strong>{treatment.label}</strong><span>{treatment.detail}</span></figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>

  <section class="dark-header-review" aria-labelledby="dark-header-review-heading">
    <header class="signal-review__head">
      <div>
        <p>Dark header · optisk kontroll</p>
        <h3 id="dark-header-review-heading">Blått eller hvitt signal ved faktisk størrelse</h3>
      </div>
      <p>
        Samme canonical geometri og samme mørke headerflate i alle felt. Bare signalbehandlingen
        varierer. Desktop vises med Primary ved 22 px; mobil med Small Y ved 20 px.
      </p>
    </header>

    <div class="dark-header-review__grid">
      <article class="dark-header-check">
        <header><strong>Desktop · dagens behandling</strong><span>Primary · 22 px</span></header>
        <div class="dark-header-check__stage">
          <img
            src={`${base}brand/viddel-wordmark-primary-5bar-inverse-blue.svg`}
            alt="VIDDEL Primary med hvitt ordmerke og blått signal"
            width="937.88"
            height="134"
            style="height: 22px"
          />
        </div>
        <footer>Inverse blue · vurder separasjonen mellom de fem stolpene</footer>
      </article>

      <article class="dark-header-check dark-header-check--candidate">
        <header><strong>Desktop · kontrastkandidat</strong><span>Primary · 22 px</span></header>
        <div class="dark-header-check__stage">
          <img
            src={`${base}brand/viddel-wordmark-primary-5bar-mono-white.svg`}
            alt="VIDDEL Primary helt i hvitt"
            width="937.88"
            height="134"
            style="height: 22px"
          />
        </div>
        <footer>Mono white · identisk geometri, maksimal lyskontrast</footer>
      </article>

      <article class="dark-header-check">
        <header><strong>Mobil · dagens behandling</strong><span>Small Y · 20 px</span></header>
        <div class="dark-header-check__stage">
          <img
            src={`${base}brand/viddel-wordmark-small-5bar-inverse-blue.svg`}
            alt="VIDDEL Small Y med hvitt ordmerke og blått signal"
            width="140"
            height="20"
            style="height: 20px"
          />
        </div>
        <footer>Inverse blue · dagens mobile behandling</footer>
      </article>

      <article class="dark-header-check dark-header-check--candidate">
        <header><strong>Mobil · kontrastkandidat</strong><span>Small Y · 20 px</span></header>
        <div class="dark-header-check__stage">
          <img
            src={`${base}brand/viddel-wordmark-small-5bar-mono-white.svg`}
            alt="VIDDEL Small Y helt i hvitt"
            width="140"
            height="20"
            style="height: 20px"
          />
        </div>
        <footer>Mono white · identisk geometri, maksimal lyskontrast</footer>
      </article>
    </div>

    <footer class="dark-header-review__note">
      Dette er en behandlingstest, ikke ny geometri. Produksjonsheaderen er ikke endret.
    </footer>
  </section>

  <div class="signal-review">
    <header class="signal-review__head">
      <div>
        <p>Standalone · stress-test</p>
        <h3>Tre signalgeometrier ved 8–32 px</h3>
      </div>
      <p>Vurder separasjon, rytme og om symbolet fortsatt oppleves som lyd – ikke bare streker.</p>
    </header>

    <div class="signal-review__grid">
      {signals.map((signal) => (
        <article class="signal-card">
          <header><strong>{signal.label}</strong><span>{signal.detail}</span></header>
          <div class="signal-card__sizes">
            {signalSizes.map((size) => (
              <figure>
                <div class="signal-card__stage">
                  <span
                    class="signal-shape"
                    role="img"
                    aria-label={`${signal.label} ved ${size} piksler`}
                    style={`--signal-url: url("${base}brand/viddel-signal-${signal.id}-${signal.bars}.svg"); --signal-height: ${size}px; --signal-aspect: ${signal.aspect}; --signal-color: #3672e6;`}
                  ></span>
                </div>
                <figcaption>{size} px</figcaption>
              </figure>
            ))}
          </div>
          <div class="signal-card__contexts">
            <div class="signal-icon signal-icon--light" aria-label={`${signal.label}, blå på lys flate`}>
              <span class="signal-shape" style={`--signal-url: url("${base}brand/viddel-signal-${signal.id}-${signal.bars}.svg"); --signal-height: 24px; --signal-aspect: ${signal.aspect}; --signal-color: #3672e6;`}></span>
            </div>
            <div class="signal-icon signal-icon--dark" aria-label={`${signal.label}, blå på mørk flate`}>
              <span class="signal-shape" style={`--signal-url: url("${base}brand/viddel-signal-${signal.id}-${signal.bars}.svg"); --signal-height: 24px; --signal-aspect: ${signal.aspect}; --signal-color: #3672e6;`}></span>
            </div>
            <div class="signal-icon signal-icon--dark" aria-label={`${signal.label}, hvit på mørk flate`}>
              <span class="signal-shape" style={`--signal-url: url("${base}brand/viddel-signal-${signal.id}-${signal.bars}.svg"); --signal-height: 24px; --signal-aspect: ${signal.aspect}; --signal-color: #ffffff;`}></span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <section class="favicon-review" aria-labelledby="favicon-review-heading">
    <header class="signal-review__head">
      <div>
        <p>Favicon · ny beslutningsport</p>
        <h3 id="favicon-review-heading">Kontrastflate rundt signalet</h3>
      </div>
      <p>
        Geometrien er låst til 15×16, Micro 5 og 2/6/10/6/2. Signal green #159A62 med hvitt
        signal er produksjonsvalget. Klar Viddel-blå #3672E6 bevares kun som et mulig senere modningsspor.
      </p>
    </header>

    <div class="favicon-grid">
      {faviconVariants.map((favicon) => (
        <article class="favicon-card">
          <header><strong>{favicon.label}</strong><span>{favicon.status}</span></header>
          <div class="favicon-card__sizes">
            <figure>
              <div class="favicon-tile" style={`--favicon-size: 16px; --favicon-background: ${favicon.background}; --favicon-fill-width: ${favicon.fillWidth}px;`}>
                <span class="favicon-tile__field" aria-hidden="true"></span>
                <span
                  class="favicon-pixel-signal"
                  role="img"
                  aria-label={`${favicon.label}, faktisk 12 pikslers signal i 16 pikslers canvas`}
                  style={`--signal-color: ${favicon.signal};`}
                >{favicon.bars.map((bar) => <i style={`left: ${bar.x}px; height: ${bar.height}px;`}></i>)}</span>
              </div>
              <figcaption><strong>{favicon.bars.map((bar) => bar.height).join("/")} px høyder</strong><span>{favicon.fillWidth}×16 px synlig flate</span></figcaption>
            </figure>
          </div>
          <div class="favicon-neighborhood" aria-label={`${favicon.label} blant generiske nabofaner`}>
            {neighborMarks.slice(0, 4).map((neighbor) => (
              <span class:list={["neighbor-mark", `neighbor-mark--${neighbor.shape}`]} style={`--neighbor-color: ${neighbor.color}; --neighbor-background: ${neighbor.background};`}>{neighbor.mark}</span>
            ))}
            <span class="favicon-neighborhood__active">
              <span class="favicon-tile" style={`--favicon-size: 16px; --favicon-background: ${favicon.background}; --favicon-fill-width: ${favicon.fillWidth}px;`}>
                <span class="favicon-tile__field" aria-hidden="true"></span>
                <span class="favicon-pixel-signal" style={`--signal-color: ${favicon.signal};`}>{favicon.bars.map((bar) => <i style={`left: ${bar.x}px; height: ${bar.height}px;`}></i>)}</span>
              </span>
              <span>Viddel</span>
            </span>
            {neighborMarks.slice(4).map((neighbor) => (
              <span class:list={["neighbor-mark", `neighbor-mark--${neighbor.shape}`]} style={`--neighbor-color: ${neighbor.color}; --neighbor-background: ${neighbor.background};`}>{neighbor.mark}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <footer class="brand-review__decision">
    <strong>Låst favicon:</strong> Signal green/white. Geometrien er 15×16, Micro 5 og
    2/6/10/6/2. Clear blue/white er dokumentert som et framtidig modningsalternativ, ikke en aktiv variant.
  </footer>
</section>

<style>
  .brand-review {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid #d9dee7;
    border-radius: 1rem;
    background: #f8fafc;
    color: #0f1b2e;
  }

  .brand-review__head,
  .signal-review__head {
    display: grid;
    gap: 0.75rem;
  }

  .brand-review__head p,
  .signal-review__head p,
  .brand-review__head h2,
  .signal-review__head h3 {
    margin: 0;
  }

  .brand-review__head > div > p,
  .signal-review__head > div > p {
    color: #3672e6;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand-review__head h2 {
    margin-top: 0.25rem;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .brand-review__head > p,
  .signal-review__head > p {
    max-width: 36rem;
    color: #667085;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .brand-review__matrix,
  .signal-review,
  .signal-review__grid,
  .favicon-grid {
    display: grid;
    gap: 0.85rem;
  }

  .wordmark-row,
  .signal-card {
    overflow: hidden;
    border: 1px solid #d9dee7;
    border-radius: 0.75rem;
    background: #fff;
  }

  .wordmark-row > header,
  .signal-card > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid #d9dee7;
    font-size: 0.72rem;
  }

  .wordmark-row > header span,
  .signal-card > header span {
    color: #667085;
  }

  .wordmark-row__treatments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .treatment {
    min-width: 0;
    margin: 0;
    border-top: 1px solid #d9dee7;
  }

  .treatment:nth-child(-n + 2) { border-top: 0; }
  .treatment:nth-child(even) { border-left: 1px solid #d9dee7; }

  .treatment__stage {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: #fff;
  }

  .treatment--dark .treatment__stage {
    background: #0f1b2e;
  }

  .treatment img {
    display: block;
    width: auto;
    max-width: 100%;
  }

  .treatment figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-top: 1px solid #d9dee7;
    color: #667085;
    font-size: 0.66rem;
  }

  .treatment figcaption strong { color: #0f1b2e; }

  .signal-review {
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid #d9dee7;
  }

  .dark-header-review {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid #d9dee7;
  }

  .dark-header-review__grid {
    display: grid;
    gap: 0.75rem;
  }

  .dark-header-check {
    overflow: hidden;
    border: 1px solid #24324a;
    border-radius: 0.75rem;
    background: #080e1c;
  }

  .dark-header-check--candidate {
    border-color: #6f8fcf;
    box-shadow: inset 0 0 0 1px rgb(111 143 207 / 0.28);
  }

  .dark-header-check > header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid #24324a;
    color: #f5f7fb;
    font-size: 0.68rem;
  }

  .dark-header-check > header span,
  .dark-header-check > footer {
    color: #aeb9cc;
  }

  .dark-header-check__stage {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    padding: 1rem 1.25rem;
  }

  .dark-header-check__stage img {
    display: block;
    width: auto;
    max-width: 100%;
  }

  .dark-header-check > footer {
    padding: 0.5rem 0.7rem;
    border-top: 1px solid #24324a;
    font-size: 0.64rem;
  }

  .dark-header-review__note {
    padding: 0.7rem 0.8rem;
    border-radius: 0.65rem;
    background: #eef3ff;
    color: #475467;
    font-size: 0.72rem;
  }

  .favicon-review {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid #d9dee7;
  }

  .favicon-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .favicon-card {
    overflow: hidden;
    border: 1px solid #d9dee7;
    border-radius: 0.75rem;
    background: #fff;
  }

  .favicon-card > header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid #d9dee7;
    font-size: 0.68rem;
  }

  .favicon-card > header span { color: #667085; }

  .favicon-card__sizes {
    display: grid;
    min-height: 6.25rem;
    place-items: center;
    justify-content: center;
    padding: 1rem;
    background-image:
      linear-gradient(rgb(15 27 46 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(15 27 46 / 0.045) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .favicon-card__sizes figure {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    margin: 0;
  }

  .favicon-card__sizes figcaption {
    display: grid;
    gap: 0.1rem;
    color: #667085;
    font-size: 0.62rem;
    text-align: center;
  }

  .favicon-card__sizes figcaption strong { color: #0f1b2e; font-size: 0.6rem; }

  .favicon-tile {
    position: relative;
    display: grid;
    width: var(--favicon-size);
    height: var(--favicon-size);
    place-items: center;
  }

  .favicon-tile__field {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--favicon-fill-width);
    border-radius: 3px;
    background: var(--favicon-background);
    filter: drop-shadow(0 1px 2px rgb(15 27 46 / 0.2));
  }

  .favicon-pixel-signal {
    position: absolute;
    inset: 0;
    display: block;
  }

  .favicon-pixel-signal i {
    position: absolute;
    top: 50%;
    width: 1px;
    transform: translateY(-50%);
    border-radius: 0.5px;
    background: var(--signal-color);
  }

  .favicon-neighborhood {
    display: flex;
    gap: 0.38rem;
    align-items: center;
    margin: 0 0.65rem 0.65rem;
    padding: 0.42rem;
    overflow: hidden;
    border-radius: 0.45rem;
    background: #efb9aa;
    color: #475467;
    font-size: 0.65rem;
  }

  .favicon-neighborhood__active {
    display: flex;
    flex: 0 0 auto;
    gap: 0.35rem;
    align-items: center;
    padding: 0.26rem 0.42rem;
    border-radius: 0.38rem;
    background: #fff;
    box-shadow: 0 1px 4px rgb(15 27 46 / 0.16);
    color: #0f1b2e;
    font-weight: 700;
  }

  .neighbor-mark {
    display: grid;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    place-items: center;
    border: 1px solid rgb(15 27 46 / 0.12);
    background: var(--neighbor-background);
    color: var(--neighbor-color);
    font-size: 8px;
    font-weight: 800;
    line-height: 1;
  }

  .neighbor-mark--round { border-radius: 50%; }
  .neighbor-mark--square { border-radius: 3px; }

  @media (max-width: 920px) {
    .favicon-grid { grid-template-columns: 1fr; }
  }

  .signal-review__head h3 {
    margin-top: 0.25rem;
    font-size: 1.1rem;
  }

  .signal-card__sizes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .signal-card__sizes figure {
    min-width: 0;
    margin: 0;
    border-top: 1px solid #e8ebf0;
    border-left: 1px solid #e8ebf0;
  }

  .signal-card__sizes figure:nth-child(-n + 3) { border-top: 0; }
  .signal-card__sizes figure:nth-child(3n + 1) { border-left: 0; }

  .signal-card__stage {
    display: grid;
    min-height: 4.5rem;
    place-items: center;
    background-image:
      linear-gradient(rgb(15 27 46 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(15 27 46 / 0.045) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .signal-card__sizes figcaption {
    padding: 0.35rem;
    border-top: 1px solid #e8ebf0;
    color: #667085;
    font-size: 0.64rem;
    text-align: center;
  }

  .signal-shape {
    display: block;
    width: calc(var(--signal-height) * var(--signal-aspect));
    height: var(--signal-height);
    background: var(--signal-color);
    -webkit-mask: var(--signal-url) center / contain no-repeat;
    mask: var(--signal-url) center / contain no-repeat;
  }

  .signal-card__contexts {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    padding: 0.75rem;
    border-top: 1px solid #d9dee7;
    background: #f8fafc;
  }

  .signal-icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid #d9dee7;
    border-radius: 0.9rem;
  }

  .signal-icon--light { background: #fff; }
  .signal-icon--dark { background: #0f1b2e; border-color: #24324a; }

  .brand-review__decision {
    padding: 0.8rem 0.9rem;
    border-radius: 0.7rem;
    background: #eaf1ff;
    color: #475467;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .brand-review__decision strong { color: #0f1b2e; }

  @media (min-width: 760px) {
    .brand-review__head,
    .signal-review__head {
