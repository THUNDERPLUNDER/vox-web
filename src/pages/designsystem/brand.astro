---
/* CONTRACT: Canonical Viddel brand asset documentation for #121. */
import VisInternalLayout from "../../layouts/VisInternalLayout.astro";
import "../../styles/global.css";
import "../../styles/designsystem-catalog.css";
import "../../styles/designsystem-brand.css";

const base = import.meta.env.BASE_URL;

const wordmarks = [
  {
    name: "Primary 5-bar",
    role: "Fra 22 px. Desktop-header bruker 22 px.",
    src: "brand/viddel-wordmark-primary-5bar.svg",
    width: 937.88,
    height: 134,
    renderHeight: 32,
  },
  {
    name: "Small 5-bar (Y)",
    role: "18–20 px. Mobil-header bruker 20 px.",
    src: "brand/viddel-wordmark-small-5bar.svg",
    width: 140,
    height: 20,
    renderHeight: 20,
  },
  {
    name: "Micro 3-bar (A)",
    role: "8–16 px. Ikke brukt i header nå.",
    src: "brand/viddel-wordmark-micro-3bar.svg",
    width: 140,
    height: 20,
    renderHeight: 16,
  },
];

const colorways = [
  { name: "Default", value: "Navy #0F1B2E + blue #3672E6", surface: "Lys bakgrunn" },
  { name: "Mono dark", value: "Alt i navy #0F1B2E", surface: "Lys bakgrunn / énfarget produksjon" },
  { name: "Inverse", value: "Hvit wordmark + blue #3672E6", surface: "Mørk eller navy bakgrunn" },
  { name: "Mono white", value: "Alt i hvitt", surface: "Mørk bakgrunn / énfarget produksjon" },
];

const signals = [
  { name: "Primary 5-bar", role: "20–32 px", src: "brand/viddel-signal-primary-5bar.svg", width: 108.57, height: 93.73 },
  { name: "Small 5-bar", role: "8–16 px", src: "brand/viddel-signal-small-5bar.svg", width: 18, height: 16.7414 },
  { name: "Micro 3-bar", role: "8 px i krevende tilfeller", src: "brand/viddel-signal-micro-3bar.svg", width: 10, height: 16.7414 },
];
---

<VisInternalLayout title="Viddel brand assets — Designsystem" showPageIntro={false}>
  <main class="ds-catalog ds-brand-page" data-design-system-catalog>
    <nav class="ds-catalog__breadcrumb" aria-label="Du er her">
      <a href={`${base}vis`}>VIS</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}designsystem`}>Designsystem</a>
      <span aria-hidden="true">/</span>
      <span>Brand assets</span>
    </nav>

    <header class="ds-catalog__hero ds-brand-page__hero">
      <p class="ds-catalog__rule-label">Canonical · #121</p>
      <h1>Logo, signal og favicon</h1>
      <p class="ds-catalog__hero-lead">
        Gjeldende geometrier og behandlinger for Viddel. Bruk filene som de er; størrelse avgjør hvilken optisk variant som velges.
      </p>
      <p class="ds-catalog__hero-note">Versjon 2026-08-24 · footer og øvrige touchpoints inngår ikke i #121.</p>
    </header>

    <section class="ds-catalog__section" aria-labelledby="brand-wordmarks">
      <h2 id="brand-wordmarks" class="ds-catalog__section-title">Wordmark-geometrier</h2>
      <div class="ds-brand-page__wordmarks">
        {wordmarks.map((wordmark) => (
          <figure class="ds-brand-page__wordmark">
            <div class="ds-brand-page__stage">
              <img src={`${base}${wordmark.src}`} alt={`VIDDEL ${wordmark.name}`} width={wordmark.width} height={wordmark.height} style={`height: ${wordmark.renderHeight}px`} />
            </div>
            <figcaption><strong>{wordmark.name}</strong><span>{wordmark.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="ds-brand-page__runtime-rule">
        <strong>Header:</strong> Primary ved 22 px fra 1024 px viewportbredde. Small Y ved 20 px under 1024 px.
        Micro A er canonical for svært små flater, men er ikke en headervariant nå.
      </p>
    </section>

    <section class="ds-catalog__section" aria-labelledby="brand-colorways">
      <h2 id="brand-colorways" class="ds-catalog__section-title">Fargebehandlinger</h2>
      <div class="ds-brand-page__table" role="table" aria-label="Godkjente logofarger">
        {colorways.map((colorway) => (
          <div class="ds-brand-page__table-row" role="row">
            <strong role="cell">{colorway.name}</strong>
            <span role="cell">{colorway.value}</span>
            <span role="cell">{colorway.surface}</span>
          </div>
        ))}
      </div>
      <p class="ds-brand-page__note">Andre farger er ikke godkjente logobehandlinger. Favicon har et eksplisitt unntak nedenfor.</p>
    </section>

    <section class="ds-catalog__section" aria-labelledby="brand-signals">
      <h2 id="brand-signals" class="ds-catalog__section-title">Standalone-signal</h2>
      <div class="ds-brand-page__signals">
        {signals.map((signal) => (
          <figure class="ds-brand-page__signal">
            <div class="ds-brand-page__signal-stage">
              <img src={`${base}${signal.src}`} alt={signal.name} width={signal.width} height={signal.height} />
            </div>
            <figcaption><strong>{signal.name}</strong><span>{signal.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="ds-catalog__section" aria-labelledby="brand-favicon">
      <h2 id="brand-favicon" class="ds-catalog__section-title">Favicon</h2>
      <div class="ds-brand-page__favicon">
        <div class="ds-brand-page__favicon-stage">
          <img src={`${base}brand/viddel-favicon-micro-5bar-green.svg`} alt="Viddel favicon, grønn flate med fem hvite signalstolper" width="16" height="16" />
        </div>
        <div>
          <h3>Signal green / white</h3>
          <p>
            Produksjonsvalg: transparent 16×16 canvas, synlig 15×16 flate i #159A62, radius 3 px og hvite Micro 5-stolper med høydene 2/6/10/6/2 px.
          </p>
          <p>
            Clear blue #3672E6 med identisk hvitt signal er dokumentert som et mulig framtidig modningsalternativ. Det er ikke en aktiv variant.
          </p>
        </div>
      </div>
    </section>

    <section class="ds-catalog__section" aria-labelledby="brand-spacing">
      <h2 id="brand-spacing" class="ds-catalog__section-title">Plass og integritet</h2>
      <div class="ds-brand-page__rules">
        <div>
          <h3>Clearspace · låst regel</h3>
          <p>
            Hold minst ½ av wordmarkets høyde fri på alle sider. Mål høyden på den valgte optiske wordmark-varianten i faktisk bruk.
          </p>
        </div>
        <div>
          <h3>Ikke endre geometrien</h3>
          <p>
            Ikke strekk, bygg om, flytt signalstolper, bytt antall stolper eller bruk en geometri utenfor størrelsesrollen. Favicon-canvaset skal ikke beskjæres.
          </p>
        </div>
      </div>
    </section>

    <footer class="ds-catalog__tech">
      <details open>
        <summary>Kilder og filplassering</summary>
        <div class="ds-catalog__tech-body ds-brand-page__sources">
          <p><strong>Web-assets:</strong> <code>public/brand/</code></p>
          <p>
            <strong>Legacy-unntak:</strong> <code>viddel-wordmark.svg</code> brukes fortsatt bare av holding-siden
            <code>/</code>. Den er ikke canonical og skal ikke brukes i nye touchpoints.
          </p>
          <p><strong>Runtime-header:</strong> <code>src/components/nav/Header.astro</code></p>
          <p><strong>Illustrator-masters:</strong> <code>2026.08.13 Viddel logo / viddellogo</code> på Drive.</p>
          <p><strong>Beslutningsspor:</strong> <a href={`${base}vis/review/logo-rasterization-v01/`}>logo-rasterisering og favicon-review</a>.</p>
        </div>
      </details>
    </footer>
  </main>
</VisInternalLayout>
