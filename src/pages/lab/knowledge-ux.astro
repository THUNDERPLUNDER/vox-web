---
/* CONTRACT: STG-0 knowledge UX smoke test (#336). Password-gated LAB only; no agent/backend calls. */
import "../../styles/global.css";
import { hasValidLabSession, isLabRouteAvailable } from "../../lib/lab-auth-v01.ts";

export const prerender = false;

if (!isLabRouteAvailable()) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (!hasValidLabSession(Astro.request)) {
  return Astro.redirect("/lab/login?return=/lab/knowledge-ux");
}

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const claim = {
  id: "CLM-SIT-001-OTI-001",
  status: "V3_EDITORIAL_APPROVED",
  releaseLabel: "BETA",
  scope: "Oticon Intent 1–4 miniRITE · FW 1.0/1.1",
  source: "Oticon Intent Instructions for Use",
  locator: "s. 80–81 · støtte fra s. 20 og 28",
  sourceUrl: "https://drive.google.com/file/d/1mgS8ohI8Ezq8fDPdwxBTft8cRgz4N4xY/view",
};
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Viddel Lab · Ingen lyd</title>
  </head>
  <body>
    <main class="lab-shell">
      <header class="lab-header">
        <div>
          <p class="eyebrow">Viddel Lab · STG-0</p>
          <h1>Høreapparatet gir ingen lyd</h1>
        </div>
        <span class="lab-badge">LAB · ikke produksjon</span>
      </header>

      <section class="conversation" aria-labelledby="question-title">
        <div class="viddel-mark" aria-hidden="true">V</div>
        <div class="bubble">
          <p class="speaker">Viddel</p>
          <h2 id="question-title">Gjelder det all lyd rundt deg – ikke bare mobil eller TV?</h2>
          <p class="hint">Velg det som passer best. Denne testen dekker ett avgrenset problem.</p>

          <div class="choices" role="group" aria-label="Velg hvilken lyd som mangler">
            <button type="button" class="choice choice-primary" data-route="all-sound">
              Ja, jeg hører ingen lyd rundt meg
            </button>
            <button type="button" class="choice" data-route="streaming">
              Nei, bare mobil eller TV
            </button>
          </div>
        </div>
      </section>

      <section id="verified-answer" class="result" hidden aria-live="polite">
        <div class="result-heading">
          <div>
            <p class="eyebrow">Kontrollert førstehjelp</p>
            <h2>Prøv dette i denne rekkefølgen</h2>
          </div>
          <span class="verified-badge">Beta · kildekontrollert</span>
        </div>

        <ol class="steps">
          <li><span>1</span><p><strong>Lad høreapparatet.</strong></p></li>
          <li><span>2</span><p><strong>Slå det på.</strong> Hold knappen inne i to sekunder. Grønt lys viser at det er på.</p></li>
          <li><span>3</span><p><strong>Kontroller at mikrofonen ikke er dempet.</strong></p></li>
          <li><span>4</span><p><strong>Se etter blokkering.</strong> Rengjør en støpt ørepropp, eller bytt voksfilter, dome eller Grip Tip med samme type som fulgte med.</p></li>
        </ol>

        <div class="stop-card">
          <strong>Fortsatt ingen lyd?</strong>
          <p>Kontakt audiograf eller annen høreapparatfaglig hjelp.</p>
        </div>

        <details class="source-card">
          <summary>Se kilde og gyldighetsområde</summary>
          <dl>
            <div><dt>Gjelder</dt><dd>{claim.scope}</dd></div>
            <div><dt>Kilde</dt><dd><a href={claim.sourceUrl} target="_blank" rel="noreferrer">{claim.source}</a>, {claim.locator}</dd></div>
            <div><dt>Påstand</dt><dd>{claim.id}</dd></div>
            <div><dt>Status</dt><dd>{claim.status}</dd></div>
            <div><dt>Publisering</dt><dd>{claim.releaseLabel} – svarformatet testes fortsatt</dd></div>
          </dl>
        </details>

        <div class="feedback" data-feedback>
          <p><strong>Var dette tydelig?</strong></p>
          <div role="group" aria-label="Gi tilbakemelding på svaret">
            <button type="button" data-feedback-value="Ja">Ja</button>
            <button type="button" data-feedback-value="Delvis">Delvis</button>
            <button type="button" data-feedback-value="Nei">Nei</button>
          </div>
          <p class="feedback-confirmation" hidden aria-live="polite"></p>
        </div>
      </section>

      <section id="streaming-answer" class="result result-muted" hidden aria-live="polite">
        <p class="eyebrow">Utenfor denne testen</p>
        <h2>Dette første LAB-svaret dekker ikke mobil- eller TV-lyd ennå.</h2>
        <p>Du har ikke fått et generelt råd som kan være feil for problemet ditt. Neste situasjonspakke kan ta for seg tilkobling og streaming.</p>
      </section>

      <footer class="lab-footer">
        <button type="button" id="restart">Start på nytt</button>
        <button type="button" id="logout">Logg ut av Lab</button>
      </footer>
    </main>

    <script>
      const verifiedAnswer = document.getElementById("verified-answer");
      const streamingAnswer = document.getElementById("streaming-answer");
      const routeButtons = document.querySelectorAll("[data-route]");

      function showResult(route) {
        if (!(verifiedAnswer instanceof HTMLElement) || !(streamingAnswer instanceof HTMLElement)) return;
        verifiedAnswer.hidden = route !== "all-sound";
        streamingAnswer.hidden = route !== "streaming";
        const target = route === "all-sound" ? verifiedAnswer : streamingAnswer;
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      routeButtons.forEach((button) => {
        button.addEventListener("click", () => showResult(button.getAttribute("data-route")));
      });

      document.querySelectorAll("[data-feedback-value]").forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.getAttribute("data-feedback-value") || "";
          document.querySelectorAll("[data-feedback-value]").forEach((item) => {
            item.setAttribute("aria-pressed", String(item === button));
          });
          const confirmation = document.querySelector(".feedback-confirmation");
          if (confirmation instanceof HTMLElement) {
            confirmation.textContent = `Takk. «${value}» er registrert bare i denne nettleserøkten.`;
            confirmation.hidden = false;
          }
        });
      });

      document.getElementById("restart")?.addEventListener("click", () => {
        if (verifiedAnswer instanceof HTMLElement) verifiedAnswer.hidden = true;
        if (streamingAnswer instanceof HTMLElement) streamingAnswer.hidden = true;
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      document.getElementById("logout")?.addEventListener("click", async () => {
        await fetch("/api/lab/logout", { method: "POST", credentials: "same-origin" });
        window.location.href = "/lab/login?return=/lab/knowledge-ux";
      });
    </script>
  </body>
</html>

<style>
  :global(body) {
    min-height: 100vh;
    margin: 0;
    color: rgb(var(--text));
    background:
      radial-gradient(circle at 10% 0%, rgb(var(--primary) / 0.13), transparent 42rem),
      rgb(var(--bg));
  }

  .lab-shell { width: min(100% - 2rem, 48rem); margin: 0 auto; padding: 2rem 0 3rem; }
  .lab-header, .result-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .lab-header { margin-bottom: 2rem; }
  h1, h2, p { margin-top: 0; }
  h1 { margin-bottom: 0; font-family: var(--font-display); font-size: clamp(1.65rem, 5vw, 2.35rem); line-height: 1.12; }
  h2 { margin-bottom: 0.65rem; font-family: var(--font-display); font-size: clamp(1.25rem, 3.5vw, 1.65rem); line-height: 1.25; }
  .eyebrow, .speaker { margin-bottom: 0.4rem; color: rgb(var(--muted)); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  .lab-badge, .verified-badge { flex: 0 0 auto; border-radius: 999px; padding: 0.45rem 0.7rem; font-size: 0.7rem; font-weight: 700; }
  .lab-badge { border: 1px solid rgb(var(--stroke) / 0.3); background: rgb(var(--surface-elevated)); color: rgb(var(--muted)); }
  .verified-badge { background: rgb(var(--primary) / 0.12); color: rgb(var(--primary)); }
  .conversation { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; align-items: start; }
  .viddel-mark { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: 50%; background: rgb(var(--primary)); color: white; font-family: var(--font-display); font-weight: 700; }
  .bubble, .result { border: 1px solid rgb(var(--stroke) / 0.2); border-radius: 1.25rem; background: rgb(var(--surface-elevated)); box-shadow: var(--shadow-card); }
  .bubble { padding: clamp(1.15rem, 4vw, 1.75rem); border-top-left-radius: 0.35rem; }
  .hint { margin-bottom: 1.25rem; color: rgb(var(--muted)); line-height: 1.55; }
  .choices { display: grid; gap: 0.7rem; }
  button { font: inherit; }
  .choice { width: 100%; cursor: pointer; border: 1px solid rgb(var(--stroke) / 0.3); border-radius: 0.8rem; padding: 0.9rem 1rem; background: rgb(var(--surface-subtle)); color: rgb(var(--text)); text-align: left; font-weight: 650; }
  .choice:hover, .choice:focus-visible { border-color: rgb(var(--primary)); outline: 3px solid rgb(var(--primary) / 0.13); }
  .choice-primary { background: rgb(var(--primary)); color: white; border-color: transparent; }
  .result { margin: 1.25rem 0 0 3.25rem; padding: clamp(1.15rem, 4vw, 1.75rem); scroll-margin-top: 1rem; }
  .steps { display: grid; gap: 0; margin: 1.35rem 0; padding: 0; list-style: none; }
  .steps li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.75rem; padding: 0.9rem 0; border-top: 1px solid rgb(var(--stroke) / 0.16); }
  .steps li > span { display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border-radius: 50%; background: rgb(var(--primary) / 0.11); color: rgb(var(--primary)); font-weight: 750; }
  .steps p, .stop-card p, .result-muted p { margin-bottom: 0; line-height: 1.55; }
  .stop-card { border-radius: 0.85rem; padding: 1rem; background: rgb(var(--focus) / 0.1); }
  .source-card { margin-top: 1rem; border-top: 1px solid rgb(var(--stroke) / 0.18); padding-top: 1rem; color: rgb(var(--muted)); font-size: 0.83rem; }
  .source-card summary { cursor: pointer; font-weight: 650; color: rgb(var(--text)); }
  .source-card dl { display: grid; gap: 0.55rem; margin-bottom: 0; }
  .source-card dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.5rem; }
  .source-card dt { font-weight: 650; }
  .source-card dd { margin: 0; overflow-wrap: anywhere; }
  .source-card a { color: rgb(var(--primary)); }
  .feedback { margin-top: 1.25rem; border-top: 1px solid rgb(var(--stroke) / 0.18); padding-top: 1.1rem; }
  .feedback > p { margin-bottom: 0.7rem; }
  .feedback div { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .feedback button, .lab-footer button { cursor: pointer; border: 1px solid rgb(var(--stroke) / 0.28); border-radius: 999px; padding: 0.55rem 0.85rem; background: transparent; color: rgb(var(--text)); font-size: 0.83rem; font-weight: 650; }
  .feedback button[aria-pressed="true"] { border-color: rgb(var(--primary)); background: rgb(var(--primary) / 0.11); color: rgb(var(--primary)); }
  .feedback-confirmation { margin-top: 0.75rem; color: rgb(var(--muted)); font-size: 0.82rem; }
  .result-muted { color: rgb(var(--muted)); }
  .result-muted h2 { color: rgb(var(--text)); }
  .lab-footer { display: flex; justify-content: space-between; gap: 1rem; margin: 1.4rem 0 0 3.25rem; }

  [hidden] { display: none !important; }

  @media (max-width: 38rem) {
    .lab-shell { width: min(100% - 1.25rem, 48rem); padding-top: 1.1rem; }
    .lab-header { display: block; }
    .lab-badge { display: inline-block; margin-top: 0.8rem; }
    .conversation { grid-template-columns: 2rem 1fr; gap: 0.55rem; }
    .viddel-mark { width: 2rem; height: 2rem; font-size: 0.8rem; }
    .result, .lab-footer { margin-left: 0; }
    .result-heading { display: block; }
    .verified-badge { display: inline-block; margin-bottom: 1rem; }
    .source-card dl div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
