---
/* CONTRACT: Standalone Viddel AI chat — open start surface, headless via /api/chat. #125M-C R1 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConversationFeedbackPanel from "../../components/conversation/ConversationFeedbackPanel.astro";
import InspectToolsDrawer from "../../components/dev/InspectToolsDrawer.astro";
import "../../styles/r1-dialog-article.css";
import "../../styles/viddel-standalone-chat.css";
import "../../styles/viddel-chat-attachment.css";
import "../../styles/viddel-chat-scroll.css";

Astro.response.headers.set("X-Robots-Tag", "noindex, follow");

const capabilityGuideCategories = [
  {
    title: "Høreapparatet virker ikke",
    questions: [
      "Høreapparatet mitt har ikke lyd. Hva kan jeg prøve først?",
      "Bare ett høreapparat virker. Hva bør jeg sjekke?",
      "Høreapparatet piper. Hva kan det skyldes?",
    ],
  },
  {
    title: "Mobil, app og Bluetooth",
    questions: [
      "Appen finner ikke høreapparatet. Hva gjør jeg?",
      "Appen sier at apparatet er koblet til, men jeg får ikke telefonlyd. Hva kan jeg sjekke?",
      "Bare ett apparat kobler til mobilen. Hva kan jeg prøve?",
    ],
  },
  {
    title: "Lyd i møter, TV og bil",
    questions: [
      "Hva kan jeg prøve i et møte med mange stemmer?",
      "TV-lyden er utydelig selv med høreapparat. Hvor begynner jeg?",
      "Lyden i bilen blir slitsom. Hva kan hjelpe?",
    ],
  },
  {
    title: "Musikk og lydkvalitet",
    questions: [
      "Musikk låter tynt og skarpt med høreapparat. Hva kan det skyldes?",
      "Musikk høres grei ut, men ikke slik jeg husker den. Hvorfor?",
      "Jeg savner små lyder som fuglesang og romklang. Hva kan jeg gjøre?",
    ],
  },
  {
    title: "Hvem hjelper med hva?",
    questions: [
      "Når bør jeg kontakte audiograf, fastlege eller NAV?",
      "Hvem kan hjelpe når høreapparatet virker, men hverdagen fortsatt er vanskelig?",
      "Jeg har et teknisk problem. Bør jeg kontakte audiografen eller leverandøren?",
    ],
  },
  {
    title: "Jobb, skole og støtte",
    questions: [
      "Hva kan gjøre møter på jobb lettere å følge?",
      "Hvilke hjelpemidler kan være aktuelle på jobb eller skole?",
      "Hvordan kan jeg forklare hørselsbehovene mine på jobb?",
    ],
  },
  {
    title: "Før timen hos audiografen",
    questions: [
      "Hva bør jeg legge merke til før neste time hos audiografen?",
      "Kan du lage en kort huskeliste til audiografen?",
      "Hvordan kan jeg beskrive at lyd blir skarp eller slitsom?",
    ],
  },
];

const publicSeedQuestions = [
  "Appen finner ikke høreapparatet. Hva gjør jeg?",
  "Hva kan gjøre møter på jobb lettere å følge?",
  "Når bør jeg kontakte audiograf, fastlege eller NAV?",
];
---

<BaseLayout
  title="Viddel - Spør Viddel"
  currentPath="/no/chat"
  headerBrand="viddel"
  shellVariant="standalone-chat"
  showHeaderDevtoolsToggle={false}
>
  <meta slot="head" name="robots" content="noindex,follow" />

  <InspectToolsDrawer>
    <section class="viddel-chat-internal-guide" aria-labelledby="viddel-chat-internal-guide-title">
      <p class="viddel-chat-internal-guide__eyebrow">Beta / QA</p>
      <h2 id="viddel-chat-internal-guide-title">Capability-guide</h2>
      <p class="viddel-chat-internal-guide__intro">Velg et spørsmål for å fylle composer. Spørsmålet sendes ikke automatisk.</p>
      <div class="viddel-chat-internal-guide__categories">
        {
          capabilityGuideCategories.map((category) => (
            <details class="viddel-chat-internal-guide__category" name="viddel-chat-internal-guide-category">
              <summary>{category.title}</summary>
              <ul class="viddel-chat-internal-guide__seeds" role="list">
                {category.questions.map((question) => (
                  <li>
                    <button type="button" data-viddel-chat-seed={question}>
                      {question}
                    </button>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
    </section>
  </InspectToolsDrawer>

  <ConversationFeedbackPanel />

  <main class="viddel-chat-standalone" data-viddel-chat>
    <div class="r1-editorial-container">
      <div data-r1-editorial class="viddel-chat-standalone__editorial">
        <section class="r1-ai-bridge px-0.5 py-1">
          <section
            class="inline-chat-shell"
            aria-labelledby="viddel-chat-title"
            data-viddel-chat-shell
            data-inline-chat-mode="progressive"
            data-inline-chat-conversation="idle"
            data-inline-chat-state="idle"
          >
            <div class="viddel-chat-start viddel-chat-start--open" data-viddel-chat-start>
              <header class="viddel-chat-start__intro" data-viddel-chat-intro>
                <h1 id="viddel-chat-title" class="sr-only">Spør Viddel</h1>
                <p class="viddel-chat-start__hint">
                  Spør Viddel om lyd, hørsel, hjelpemidler, eller annet som handler om å høre bedre i hverdagen
                </p>
              </header>

              <div class="viddel-chat-start__surface viddel-chat-start__surface--open" data-viddel-chat-start-surface>
                <div class="inline-chat-shell__compose-stack" data-viddel-chat-compose-stack>
                  <p class="inline-chat-shell__status inline-chat-shell__status--dock hidden" data-viddel-chat-loading role="status">
                    Viddel svarer …
                  </p>
                  <p class="viddel-chat-standalone__error hidden" data-viddel-chat-error role="alert"></p>
                  <div class="viddel-chat-attach__attach-layer hidden" data-viddel-chat-attach-layer>
                    <div
                      class="viddel-chat-attach__attach-menu-backdrop hidden"
                      data-viddel-chat-attach-backdrop
                      aria-hidden="true"
                    >
                    </div>
                    <div
                      id="viddel-chat-attach-menu"
                      class="viddel-chat-attach__attach-menu hidden"
                      data-viddel-chat-attach-menu
                      role="menu"
                      aria-label="Flere valg"
                    >
                      <div data-viddel-chat-capabilities-root role="none">
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-item"
                          data-viddel-chat-image-trigger
                          role="menuitem"
                        >
                          <span class="viddel-chat-attach__attach-menu-item-content">
                            <svg
                              class="viddel-chat-attach__attach-menu-icon"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.85"
                              aria-hidden="true"
                            >
                              <rect x="4" y="5" width="16" height="14" rx="2" stroke-linecap="round" stroke-linejoin="round"
                              ></rect>
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 14.5 11 11.5l2.5 3 2-1.5L18 15"
                              ></path>
                              <circle cx="9" cy="9" r="1"></circle>
                            </svg>
                            <span>Legg til bilde</span>
                            <span class="viddel-chat-attach__attach-menu-chevron" aria-hidden="true">›</span>
                          </span>
                        </button>
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-item"
                          data-viddel-chat-question-trigger
                          role="menuitem"
                        >
                          <span class="viddel-chat-attach__attach-menu-item-content">
                            <svg
                              class="viddel-chat-attach__attach-menu-icon"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.85"
                              aria-hidden="true"
                            >
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 6.5h14v9H9l-4 3v-12z"></path>
                            </svg>
                            <span>Forslag til spørsmål</span>
                            <span class="viddel-chat-attach__attach-menu-chevron" aria-hidden="true">›</span>
                          </span>
                        </button>
                      </div>
                      <div class="hidden" data-viddel-chat-image-panel role="none">
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-back"
                          data-viddel-chat-capabilities-back
                          role="menuitem"
                        >
                          <span aria-hidden="true">‹</span>
                          Legg til bilde
                        </button>
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-item viddel-chat-attach__attach-menu-item--camera"
                          data-viddel-chat-attach-camera
                          role="menuitem"
                        >
                          <span class="viddel-chat-attach__attach-menu-item-content">
                            <svg
                              class="viddel-chat-attach__attach-menu-icon"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.85"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4 8h3l2-2h6l2 2h3v11H4V8z"
                              ></path>
                              <circle cx="12" cy="13" r="3.25"></circle>
                            </svg>
                            <span>Ta bilde</span>
                          </span>
                        </button>
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-item"
                          data-viddel-chat-attach-pick
                          role="menuitem"
                        >
                          <span class="viddel-chat-attach__attach-menu-item-content">
                            <svg
                              class="viddel-chat-attach__attach-menu-icon"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.85"
                              aria-hidden="true"
                            >
                              <rect x="4" y="5" width="16" height="14" rx="2" stroke-linecap="round" stroke-linejoin="round"
                              ></rect>
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 14.5 11 11.5l2.5 3 2-1.5L18 15"
                              ></path>
                              <circle cx="9" cy="9" r="1"></circle>
                            </svg>
                            <span class="viddel-chat-attach__attach-menu-label--mobile">Velg bilde</span>
                            <span class="viddel-chat-attach__attach-menu-label--desktop">Last opp bilde</span>
                          </span>
                        </button>
                      </div>
                      <div class="hidden" data-viddel-chat-question-panel role="none">
                        <button
                          type="button"
                          class="viddel-chat-attach__attach-menu-back"
                          data-viddel-chat-capabilities-back
                          role="menuitem"
                        >
                          <span aria-hidden="true">‹</span>
                          Forslag til spørsmål
                        </button>
                        <ul class="viddel-chat-attach__question-list" role="none">
                          {
                            publicSeedQuestions.map((question) => (
                              <li role="none">
                                <button
                                  type="button"
                                  class="viddel-chat-attach__question-item"
                                  data-viddel-chat-seed={question}
                                  role="menuitem"
                                >
                                  {question}
                                </button>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    </div>
                  </div>
                  <form class="inline-chat-shell__compose viddel-chat-attach__compose" data-viddel-chat-form>
                    <input
                      id="viddel-chat-file"
                      type="file"
                      accept="image/*"
                      class="sr-only"
                      data-viddel-chat-file
                    />
                    <div class="viddel-chat-attach__attachment-strip hidden" data-viddel-chat-attachment-strip>
                      <div class="viddel-chat-attach__attachment-list" data-viddel-chat-attachment-list>
                        <div class="viddel-chat-attach__attachment" data-viddel-chat-attachment>
                          <img class="viddel-chat-attach__thumb" data-viddel-chat-thumb alt="Valgt utstyr-bilde" />
                          <button
                            type="button"
                            class="viddel-chat-attach__remove-attachment"
                            data-viddel-chat-remove
                            aria-label="Fjern bilde"
                          >
                            ×
                          </button>
                        </div>
                      </div>
                    </div>
                    <div class="viddel-chat-attach__compose-row">
                      <div class="viddel-chat-attach__attach-wrap" data-viddel-chat-attach-wrap>
                        <button
                          type="button"
                          class="viddel-chat-attach__attach"
                          data-viddel-chat-attach
                          aria-label="Flere valg"
                          aria-haspopup="menu"
                          aria-expanded="false"
                          aria-controls="viddel-chat-attach-menu"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" aria-hidden="true">
                            <path stroke-linecap="round" d="M12 5v14M5 12h14"></path>
                          </svg>
                        </button>
                      </div>
                      <div class="inline-chat-shell__compose-input-wrap viddel-chat-attach__compose-input-wrap">
                        <label class="sr-only" for="viddel-chat-input">Skriv spørsmål til Viddel</label>
                        <textarea
                          id="viddel-chat-input"
                          data-viddel-chat-input
                          class="inline-chat-shell__compose-input"
                          rows="1"
                          enterkeyhint="send"
                          placeholder="Hva lurer du på?"
                        ></textarea>
                      </div>
                      <button
                        type="submit"
                        class="inline-chat-shell__compose-send"
                        data-viddel-chat-send
                        aria-label="Send spørsmål"
                        disabled
                      >
                        <span aria-hidden="true">↑</span>
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="inline-chat-shell__dialog-thread mt-3 hidden" data-viddel-chat-dialog>
              <div class="viddel-chat-scroll__viewport" data-viddel-chat-scroll-viewport>
                <div class="viddel-chat-scroll__top-spacer" aria-hidden="true"></div>
                <div class="inline-chat-shell__transcript-divider">
                  <span class="inline-chat-shell__transcript-divider-line" aria-hidden="true"></span>
                  <span class="inline-chat-shell__transcript-divider-label" id="viddel-chat-dialog-label">
                    Dialog med Viddel
                  </span>
                </div>
                <div
                  class="inline-chat-shell__transcript"
                  data-viddel-chat-transcript
                  role="log"
                  aria-live="polite"
                  aria-relevant="additions text"
                >
                </div>
                <div class="viddel-chat-feedback-trigger hidden" data-viddel-feedback-trigger-wrap>
                  <button
                    type="button"
                    data-viddel-feedback-trigger
                    aria-controls="conversation-feedback-panel"
                    aria-haspopup="dialog"
                  >
                    Gi tilbakemelding
                  </button>
                </div>
                <div class="viddel-chat-scroll__bottom-spacer" data-viddel-chat-scroll-spacer aria-hidden="true"></div>
              </div>
            </div>
          </section>
        </section>
      </div>
    </div>
  </main>

  <dialog class="viddel-owner-panel" data-viddel-owner-panel aria-labelledby="viddel-owner-title">
    <div class="viddel-owner-panel__card">
      <div class="viddel-owner-panel__header">
        <div>
          <p class="viddel-owner-panel__eyebrow">Midlertidig eierkontroll</p>
          <h2 id="viddel-owner-title">Tilgang til Viddel</h2>
        </div>
        <button type="button" class="viddel-owner-panel__close" data-viddel-owner-close aria-label="Lukk">×</button>
      </div>

      <form class="viddel-owner-panel__login" data-viddel-owner-login>
        <label for="viddel-owner-pin">Eierkode</label>
        <div class="viddel-owner-panel__pin-row">
          <input
            id="viddel-owner-pin"
            data-viddel-owner-pin
            type="password"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{4}"
            maxlength="4"
            placeholder="••••"
            required
          />
          <button type="submit">Lås opp</button>
        </div>
      </form>

      <div class="viddel-owner-panel__controls hidden" data-viddel-owner-controls>
        <p class="viddel-owner-panel__owner-state">Eiertilgang er aktiv på denne enheten.</p>
        <p class="viddel-owner-panel__owner-note">
          Du kommer gjennom selv når offentlig AI-tilgang er slått av.
        </p>
        <button type="button" class="viddel-owner-panel__logout" data-viddel-owner-logout>
          Glem eiertilgang på denne enheten
        </button>
      </div>

      <p class="viddel-owner-panel__message hidden" data-viddel-owner-message role="status"></p>
    </div>
  </dialog>

  <style is:global>
    body.vox-shell--standalone-chat {
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }

    @media (max-width: 639px) {
      body.vox-shell--standalone-chat {
        height: 100dvh;
      }

      body.vox-shell--standalone-chat .vox-shell-standalone-chat__stage {
        flex: 1 1 auto;
        min-height: 0;
      }
    }

    .viddel-owner-panel {
      background: transparent;
      border: 0;
      color: rgb(var(--text));
      margin: auto;
      max-width: min(92vw, 28rem);
      padding: 0;
      width: 100%;
    }

    .viddel-owner-panel::backdrop {
      background: rgb(2 6 23 / 0.38);
      backdrop-filter: blur(5px);
    }

    .viddel-owner-panel__card {
      background: rgb(var(--surface-elevated));
      border: 1px solid rgb(var(--border) / 0.55);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      display: grid;
      gap: 1rem;
      padding: 1.25rem;
    }

    .viddel-owner-panel__header,
    .viddel-owner-panel__pin-row {
      align-items: center;
      display: flex;
      gap: 0.75rem;
      justify-content: space-between;
    }

    .viddel-owner-panel__eyebrow,
    .viddel-owner-panel__owner-state,
    .viddel-owner-panel__owner-note,
    .viddel-owner-panel__message {
      color: rgb(var(--text-secondary));
      font-size: 0.78rem;
      margin: 0;
    }

    .viddel-owner-panel h2 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin: 0.15rem 0 0;
    }

    .viddel-owner-panel__close {
      background: transparent;
      border: 0;
      color: rgb(var(--muted));
      cursor: pointer;
      font-size: 1.4rem;
      padding: 0.25rem 0.5rem;
    }

    .viddel-owner-panel__login,
    .viddel-owner-panel__controls {
      display: grid;
      gap: 0.75rem;
    }

    .viddel-owner-panel__login label {
      font-size: 0.9rem;
      font-weight: 600;
    }

    .viddel-owner-panel__pin-row input {
      background: rgb(var(--surface));
      border: 1px solid rgb(var(--border) / 0.75);
      border-radius: var(--radius-md);
      color: rgb(var(--text));
      font: 600 1.2rem/1 var(--font-sans);
      letter-spacing: 0.35em;
      min-width: 0;
      padding: 0.8rem 0.9rem;
      width: 100%;
    }

    .viddel-owner-panel__pin-row button,
    .viddel-owner-panel__logout {
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.8rem 1rem;
      white-space: nowrap;
    }

    .viddel-owner-panel__pin-row button {
      background: rgb(var(--text));
      border: 1px solid rgb(var(--text));
      color: rgb(var(--surface));
    }

    .viddel-owner-panel__owner-note {
      background: rgb(var(--surface-subtle));
      border-radius: var(--radius-md);
      line-height: 1.4;
      margin: 0;
      padding: 0.9rem;
    }

    .viddel-owner-panel__logout {
      background: transparent;
      border: 1px solid rgb(var(--border) / 0.7);
      color: rgb(var(--text-secondary));
    }
  </style>

  <script>
    import { initChatAttachmentMenu } from "../../lib/chat-image-attachment-menu-v01";
    import {
      fileToImageBase64Payload,
      validateChatImageFile,
    } from "../../lib/chat-image-file-v01";
    import { composeChatImageMessage } from "../../lib/chat-image-message-v01";
    import { renderAssistantMarkdownInto } from "../../lib/render-assistant-markdown";

    (() => {
      const root = document.querySelector("[data-viddel-chat]");
      const shell = root?.querySelector("[data-viddel-chat-shell]");
      const intro = root?.querySelector("[data-viddel-chat-intro]");
      const dialog = root?.querySelector("[data-viddel-chat-dialog]");
      const scrollViewport = root?.querySelector("[data-viddel-chat-scroll-viewport]");
      const transcript = root?.querySelector("[data-viddel-chat-transcript]");
      const feedbackTriggerWrap = root?.querySelector<HTMLElement>("[data-viddel-feedback-trigger-wrap]");
      const feedbackTrigger = root?.querySelector<HTMLButtonElement>("[data-viddel-feedback-trigger]");
      const composeStack = root?.querySelector("[data-viddel-chat-compose-stack]");
      const startGroup = shell?.querySelector("[data-viddel-chat-start]");
      const loadingEl = root?.querySelector("[data-viddel-chat-loading]");
      const errorEl = root?.querySelector("[data-viddel-chat-error]");
      const form = root?.querySelector("[data-viddel-chat-form]");
      const input = root?.querySelector("[data-viddel-chat-input]");
      const sendBtn = root?.querySelector("[data-viddel-chat-send]");
      const fileInput = root?.querySelector("[data-viddel-chat-file]");
      const attachLayer = root?.querySelector("[data-viddel-chat-attach-layer]");
      const attachBtn = root?.querySelector("[data-viddel-chat-attach]");
      const attachMenu = root?.querySelector("[data-viddel-chat-attach-menu]");
      const attachBackdrop = root?.querySelector("[data-viddel-chat-attach-backdrop]");
      const attachCameraBtn = root?.querySelector("[data-viddel-chat-attach-camera]");
      const attachPickBtn = root?.querySelector("[data-viddel-chat-attach-pick]");
      const capabilitiesRoot = root?.querySelector<HTMLElement>("[data-viddel-chat-capabilities-root]");
      const imageTrigger = root?.querySelector<HTMLButtonElement>("[data-viddel-chat-image-trigger]");
      const questionTrigger = root?.querySelector<HTMLButtonElement>("[data-viddel-chat-question-trigger]");
      const imagePanel = root?.querySelector<HTMLElement>("[data-viddel-chat-image-panel]");
      const questionPanel = root?.querySelector<HTMLElement>("[data-viddel-chat-question-panel]");
      const capabilitiesBackButtons = root?.querySelectorAll<HTMLButtonElement>("[data-viddel-chat-capabilities-back]") ?? [];
      const attachmentStrip = root?.querySelector("[data-viddel-chat-attachment-strip]");
      const thumbEl = root?.querySelector("[data-viddel-chat-thumb]");
      const removeBtn = root?.querySelector("[data-viddel-chat-remove]");
      const seedButtons = document.querySelectorAll<HTMLButtonElement>("[data-viddel-chat-seed]");
      const ownerPanel = document.querySelector<HTMLDialogElement>("[data-viddel-owner-panel]");
      const ownerClose = ownerPanel?.querySelector<HTMLButtonElement>("[data-viddel-owner-close]");
      const ownerLogin = ownerPanel?.querySelector<HTMLFormElement>("[data-viddel-owner-login]");
      const ownerPinInput = ownerPanel?.querySelector<HTMLInputElement>("[data-viddel-owner-pin]");
      const ownerControls = ownerPanel?.querySelector<HTMLElement>("[data-viddel-owner-controls]");
      const ownerLogout = ownerPanel?.querySelector<HTMLButtonElement>("[data-viddel-owner-logout]");
      const ownerMessage = ownerPanel?.querySelector<HTMLElement>("[data-viddel-owner-message]");

      if (
        !root ||
        !shell ||
        !intro ||
        !dialog ||
        !scrollViewport ||
        !transcript ||
        !feedbackTriggerWrap ||
        !feedbackTrigger ||
        !composeStack ||
        !loadingEl ||
        !errorEl ||
        !form ||
        !input ||
        !sendBtn ||
        !fileInput ||
        !attachLayer ||
        !attachBtn ||
        !attachMenu ||
        !attachBackdrop ||
        !attachCameraBtn ||
        !attachPickBtn ||
        !capabilitiesRoot ||
        !imageTrigger ||
        !questionTrigger ||
        !imagePanel ||
        !questionPanel ||
        !attachmentStrip ||
        !thumbEl ||
        !removeBtn
      ) {
        return;
      }

      const SESSION_KEY = "viddel-chat-session";
      const SESSION_PATTERN = /^[a-zA-Z0-9][a-zA-Z0-9-_]{4,62}$/;
      const params = new URLSearchParams(window.location.search);
      const seedFromUrl = (params.get("seed") || params.get("q") || "").trim();
      const entrySurface = (params.get("from") || "standalone").trim() || "standalone";

      if (typeof window.viddelTrack === "function") {
        window.viddelTrack("chat_opened", { entry_surface: entrySurface });
      }

      let isSending = false;
      let hasConversation = false;
      let pendingSeed = seedFromUrl;
      let selectedGuideSeed = "";
      let activeTurn = null;
      /** @type {HTMLElement | null} */
      let pendingAssistantEl = null;
      /** First turn keeps top offset; scroll to end after first assistant reply. */
      let isInitialConversation = true;
      /** @type {{ file: File; previewUrl: string } | null} */
      let selectedFile = null;

      const BODY_IMAGE_WARNING = /øre|hud|kropp|ansikt|person/i;

      const setOwnerMessage = (message = "") => {
        if (!ownerMessage) return;
        ownerMessage.textContent = message;
        ownerMessage.classList.toggle("hidden", !message);
      };

      const refreshOwnerPanel = async () => {
        if (!ownerPanel || !ownerLogin || !ownerControls) return;
        setOwnerMessage("");
        try {
          const response = await fetch("/api/owner-access/status", { credentials: "same-origin", cache: "no-store" });
          const state = await response.json();
          ownerLogin.classList.toggle("hidden", state.owner === true);
          ownerControls.classList.toggle("hidden", state.owner !== true);
          if (!state.ownerConfigured) setOwnerMessage("Eierkontrollen er ikke konfigurert ennå.");
        } catch {
          setOwnerMessage("Kunne ikke hente status akkurat nå.");
        }
      };

      const openOwnerPanel = () => {
        if (!ownerPanel || typeof ownerPanel.showModal !== "function") return;
        ownerPanel.showModal();
        refreshOwnerPanel().finally(() => ownerPinInput?.focus());
      };

      let ownerGestureClicks = 0;
      let ownerGestureTimer = 0;
      intro.addEventListener("click", () => {
        window.clearTimeout(ownerGestureTimer);
        ownerGestureClicks += 1;
        if (ownerGestureClicks >= 5) {
          ownerGestureClicks = 0;
          openOwnerPanel();
          return;
        }
        ownerGestureTimer = window.setTimeout(() => { ownerGestureClicks = 0; }, 1800);
      });

      ownerClose?.addEventListener("click", () => ownerPanel?.close());
      ownerPanel?.addEventListener("click", (event) => {
        if (event.target === ownerPanel) ownerPanel.close();
      });

      ownerLogin?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const pin = ownerPinInput?.value.trim() ?? "";
        if (!/^\d{4}$/.test(pin)) {
          setOwnerMessage("Skriv inn fire sifre.");
          return;
        }
        setOwnerMessage("Kontrollerer …");
        const response = await fetch("/api/owner-access/unlock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ pin }),
        });
        ownerPinInput.value = "";
        if (!response.ok) {
          setOwnerMessage(response.status === 401 ? "Feil kode." : "Kunne ikke låse opp akkurat nå.");
          return;
        }
        await refreshOwnerPanel();
        setOwnerMessage("Eiertilgang er aktiv.");
      });

      ownerLogout?.addEventListener("click", async () => {
        await fetch("/api/owner-access/logout", { method: "POST", credentials: "same-origin" });
        await refreshOwnerPanel();
        setOwnerMessage("Eiertilgangen er fjernet fra denne enheten.");
      });

      const ensureSessionId = () => {
        try {
          const existing = sessionStorage.getItem(SESSION_KEY);
          if (existing && SESSION_PATTERN.test(existing)) return existing;
        } catch (_) {}
        const created = `viddel-${crypto.randomUUID().replace(/-/g, "").slice(0, 24)}`;
        try {
          sessionStorage.setItem(SESSION_KEY, created);
        } catch (_) {}
        return created;
      };

      const syncComposeReserve = () => {
        const reserveEl = !hasConversation && startGroup ? startGroup : composeStack;
        const rect = reserveEl.getBoundingClientRect();
        const blockedBottom = Math.max(0, Math.ceil(window.innerHeight - rect.top)) + 20;
        const blockedPx = `${blockedBottom}px`;
        root.style.setProperty("--viddel-chat-bottom-spacer", blockedPx);
        shell.style.setProperty("--inline-chat-bottom-reserve", blockedPx);
        document.body.style.setProperty("--viddel-chat-compose-reserve", blockedPx);
      };

      const scrollDialogToStart = () => {
        requestAnimationFrame(() => {
          scrollViewport.scrollTop = 0;
        });
      };

      const scrollDialogToEnd = () => {
        requestAnimationFrame(() => {
          scrollViewport.scrollTop = Math.max(0, scrollViewport.scrollHeight - scrollViewport.clientHeight);
        });
      };

      const scrollDialogInitial = () => {
        requestAnimationFrame(() => {
          scrollViewport.scrollTop = 0;
          const anchor = activeTurn ?? pendingAssistantEl;
          anchor?.scrollIntoView({ behavior: "smooth", block: "nearest" });
        });
      };

      const scrollAfterContent = () => {
        if (isInitialConversation) {
          scrollDialogInitial();
          return;
        }
        scrollDialogToEnd();
      };

      const completeInitialConversation = () => {
        if (!isInitialConversation) return;
        isInitialConversation = false;
        scrollViewport.removeAttribute("data-viddel-chat-initial-conversation");
      };

      const activateConversation = () => {
        if (hasConversation) return;
        hasConversation = true;
        intro.classList.add("hidden");
        dialog.classList.remove("hidden");
        shell.setAttribute("data-inline-chat-conversation", "active");
        shell.setAttribute("data-inline-chat-state", "active");
        shell.setAttribute("aria-labelledby", "viddel-chat-dialog-label");
        document.body.setAttribute("data-viddel-chat-active", "true");
        scrollViewport.setAttribute("data-viddel-chat-initial-conversation", "true");
        syncComposeReserve();
        scrollDialogToStart();
      };

      const canSend = () => {
        if (isSending) return false;
        const hasText = Boolean(input.value.trim());
        const hasImage = Boolean(selectedFile);
        return hasText || hasImage;
      };

      const updateSendState = () => {
        const enabled = canSend();
        sendBtn.disabled = !enabled;
        sendBtn.setAttribute("aria-disabled", String(!enabled));
      };

      const refreshSendState = () => {
        requestAnimationFrame(updateSendState);
      };

      const clearAttachment = ({ revokePreview = true } = {}) => {
        if (revokePreview && selectedFile?.previewUrl) URL.revokeObjectURL(selectedFile.previewUrl);
        selectedFile = null;
        fileInput.value = "";
        thumbEl.removeAttribute("src");
        attachmentStrip.classList.add("hidden");
        refreshSendState();
        resizeInput();
        syncComposeReserve();
      };

      const setAttachment = (file) => {
        clearAttachment();
        const validation = validateChatImageFile(file);
        if (!validation.ok) {
          showError(validation.message);
          return;
        }
        clearError();
        const previewUrl = URL.createObjectURL(file);
        thumbEl.src = previewUrl;
        attachmentStrip.classList.remove("hidden");
        selectedFile = { file, previewUrl };
        refreshSendState();
        resizeInput();
        input.focus();
      };

      const resetComposerAfterSend = () => {
        input.value = "";
        clearAttachment({ revokePreview: false });
        resizeInput();
        refreshSendState();
      };

      const appendUserMessage = (text, previewUrl) => {
        const turn = document.createElement("div");
        turn.className = "inline-chat-shell__turn";

        if (previewUrl) {
          const userTurn = document.createElement("div");
          userTurn.className = "viddel-chat-attach__user-turn";
          const img = document.createElement("img");
          img.className = "viddel-chat-attach__message-thumb";
          img.src = previewUrl;
          img.alt = "Vedlagt utstyr-bilde";
          userTurn.append(img);
          const message = document.createElement("div");
          message.className = "inline-chat-shell__message inline-chat-shell__message--user";
          const body = document.createElement("p");
          body.className = "inline-chat-shell__message-text";
          body.textContent = text || "Bilde av utstyr";
          message.append(body);
          userTurn.append(message);
          turn.append(userTurn);
        } else {
          turn.innerHTML = `
            <div class="inline-chat-shell__message inline-chat-shell__message--user">
              <p class="inline-chat-shell__message-text"></p>
            </div>
          `;
          turn.querySelector(".inline-chat-shell__message-text").textContent = text;
        }

        transcript.append(turn);
        activeTurn = turn;
        scrollAfterContent();
      };

      const removePendingAssistant = () => {
        pendingAssistantEl?.remove();
        pendingAssistantEl = null;
      };

      const showPendingAssistant = (label = "Viddel svarer …") => {
        if (!activeTurn) return;
        removePendingAssistant();
        const assistant = document.createElement("div");
        assistant.className =
          "inline-chat-shell__message inline-chat-shell__message--assistant viddel-chat-scroll__message--pending";
        assistant.setAttribute("data-viddel-chat-pending", "");
        const eyebrow = document.createElement("p");
        eyebrow.className = "inline-chat-shell__message-eyebrow";
        eyebrow.textContent = "Viddel";
        const body = document.createElement("p");
        body.className = "inline-chat-shell__message-text";
        body.textContent = label;
        assistant.append(eyebrow, body);
        activeTurn.append(assistant);
        pendingAssistantEl = assistant;
        scrollAfterContent();
      };

      const appendAssistantMessage = (text) => {
        if (!activeTurn) return;
        removePendingAssistant();
        const assistant = document.createElement("div");
        assistant.className = "inline-chat-shell__message inline-chat-shell__message--assistant";
        const eyebrow = document.createElement("p");
        eyebrow.className = "inline-chat-shell__message-eyebrow";
        eyebrow.textContent = "Viddel";
        const body = document.createElement("div");
        body.className = "inline-chat-shell__message-text";
        renderAssistantMarkdownInto(body, text);
        assistant.append(eyebrow, body);
        activeTurn.append(assistant);
        feedbackTriggerWrap.classList.remove("hidden");
        completeInitialConversation();
        scrollDialogToEnd();
      };

      const showError = (message) => {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      };

      const clearError = () => {
        errorEl.textContent = "";
        errorEl.classList.add("hidden");
      };

      const setLoading = (active) => {
        loadingEl.classList.toggle("hidden", !active);
        syncComposeReserve();
      };

      const beginTranscriptPending = (label) => {
        showPendingAssistant(label);
        setLoading(false);
      };

      const resizeInput = () => {
        const minHeight = 46;
        input.style.height = "auto";
        const nextHeight = Math.max(minHeight, input.scrollHeight);
        const isExpanded = input.value.includes("\n") || nextHeight > minHeight + 2;
        input.toggleAttribute("data-chat-input-expanded", isExpanded);
        input.style.height = isExpanded ? `${nextHeight}px` : "";
        syncComposeReserve();
        updateSendState();
      };

      const handleComposerInput = () => {
        if (selectedGuideSeed && input.value.trim() !== selectedGuideSeed) selectedGuideSeed = "";
        resizeInput();
      };

      const submitIfReady = () => {
        if (!canSend()) return;
        sendMessage(input.value);
      };

      const friendlyError = (payload, status = 0) => {
        if (status === 429 || payload?.error === "rate_limited") {
          return "Du har stilt mange spørsmål på kort tid. Prøv igjen litt senere.";
        }
        if (typeof payload?.message === "string" && payload.message.trim()) {
          return payload.message.trim();
        }
        if (payload?.error === "configuration_missing") {
          return "Viddel er ikke tilgjengelig akkurat nå. Prøv igjen om litt.";
        }
        if (payload?.error === "invalid_message") {
          return "Skriv et spørsmål før du sender.";
        }
        return "Vi fikk ikke tak i svaret akkurat nå. Prøv igjen.";
      };

      const visionFailureMessage = (payload, status = 0) => {
        if (status === 429 || payload?.error === "rate_limited") {
          return "Du har analysert flere bilder på kort tid. Prøv igjen litt senere.";
        }
        if (typeof payload?.message === "string" && payload.message.trim()) return payload.message.trim();
        return "Jeg klarte ikke å analysere bildet akkurat nå. Prøv et tydelig bilde av høreapparatutstyret, eller still spørsmålet som tekst.";
      };

      const hasUnsafeImageWarnings = (warnings) => {
        if (!Array.isArray(warnings)) return false;
        return warnings.some((warning) => typeof warning === "string" && BODY_IMAGE_WARNING.test(warning));
      };

      const sendMessageWithImage = async () => {
        if (!selectedFile || isSending) return;

        const userProblem = input.value.trim();
        const previewForMessage = selectedFile.previewUrl;
        const fileForUpload = selectedFile.file;

        clearError();
        activateConversation();
        appendUserMessage(userProblem, previewForMessage);
        resetComposerAfterSend();
        beginTranscriptPending("Viddel analyserer …");
        isSending = true;
        refreshSendState();
        input.disabled = true;
        attachBtn.disabled = true;
        removeBtn.disabled = true;

        try {
          const { base64, mimeType } = await fileToImageBase64Payload(fileForUpload);

          const visionRes = await fetch("/api/image-vision", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({
              imageBase64: base64,
              mimeType,
              userProblem,
            }),
          });
          const visionPayload = await visionRes.json().catch(() => ({}));

          if (!visionRes.ok) {
            removePendingAssistant();
            showError(visionFailureMessage(visionPayload, visionRes.status));
            return;
          }

          if (hasUnsafeImageWarnings(visionPayload.warnings)) {
            removePendingAssistant();
            showError(
              "Bildet ser ut til å vise person eller kropp. Ta et bilde av høreapparatutstyret alene, uten øre, hud eller ansikt.",
            );
            return;
          }

          if (!visionPayload.vision) {
            removePendingAssistant();
            showError(visionFailureMessage(visionPayload));
            return;
          }

          const composedMessage = composeChatImageMessage(visionPayload.vision, userProblem);
          const response = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message: composedMessage,
              sessionId: ensureSessionId(),
            }),
          });
          const payload = await response.json().catch(() => ({}));

          if (!response.ok) {
            removePendingAssistant();
            showError(friendlyError(payload, response.status));
            return;
          }

          const text = typeof payload.text === "string" ? payload.text.trim() : "";
          if (!text) {
            removePendingAssistant();
            showError("Vi fikk ikke tak i svaret akkurat nå. Prøv igjen.");
            return;
          }

          clearError();
          if (typeof window.viddelTrack === "function") {
            window.viddelTrack("chat_answer_success", { entry_surface: entrySurface });
          }
          appendAssistantMessage(text);
        } catch (_) {
          removePendingAssistant();
          if (typeof window.viddelTrack === "function") {
            window.viddelTrack("chat_answer_error", { entry_surface: entrySurface, error_code: "network_error" });
          }
          showError("Nettverksfeil. Sjekk tilkoblingen og prøv igjen.");
        } finally {
          isSending = false;
          input.disabled = false;
          attachBtn.disabled = false;
          removeBtn.disabled = false;
          refreshSendState();
          setLoading(false);
          input.focus();
          syncComposeReserve();
        }
      };

      const sendMessage = async (rawMessage) => {
        const message = (rawMessage || "").trim();
        if (selectedFile) {
          await sendMessageWithImage();
          return;
        }
        if (!message || isSending) return;

        clearError();
        activateConversation();
        appendUserMessage(message, null);
        input.value = "";
        resizeInput();
        beginTranscriptPending();
        isSending = true;
        refreshSendState();
        input.disabled = true;

        const inputType = selectedGuideSeed && message === selectedGuideSeed
          ? "seed"
          : seedFromUrl && message === seedFromUrl
            ? "seed"
            : "freeform";

        if (typeof window.viddelTrack === "function") {
          const trackProps = { entry_surface: entrySurface, input_type: inputType };
          if (inputType === "seed" && typeof window.viddelSeedId === "function") {
            trackProps.seed_id = window.viddelSeedId(message);
          }
          window.viddelTrack("chat_question_sent", trackProps);
        }
        selectedGuideSeed = "";

        try {
          const response = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message,
              sessionId: ensureSessionId(),
            }),
          });
          const payload = await response.json().catch(() => ({}));

          if (!response.ok) {
            const trackedCode = response.status === 429
              ? "rate_limited"
              : typeof payload?.error === "string"
                ? payload.error
                : "unknown";
            if (typeof window.viddelTrack === "function") {
              if (trackedCode === "rate_limited") {
                window.viddelTrack("chat_rate_limited", { entry_surface: entrySurface, error_code: trackedCode });
              } else if (trackedCode === "message_too_long") {
                window.viddelTrack("chat_message_too_long", { entry_surface: entrySurface, error_code: trackedCode });
              } else {
                window.viddelTrack("chat_answer_error", { entry_surface: entrySurface, error_code: trackedCode });
              }
            }
            removePendingAssistant();
            showError(friendlyError(payload, response.status));
            return;
          }

          const text = typeof payload.text === "string" ? payload.text.trim() : "";
          if (!text) {
            removePendingAssistant();
            if (typeof window.viddelTrack === "function") {
              window.viddelTrack("chat_answer_error", { entry_surface: entrySurface, error_code: "empty_response" });
            }
            showError("Vi fikk ikke tak i svaret akkurat nå. Prøv igjen.");
            return;
          }

          clearError();
          if (typeof window.viddelTrack === "function") {
            window.viddelTrack("chat_answer_success", { entry_surface: entrySurface });
          }
          appendAssistantMessage(text);
        } catch (_) {
          removePendingAssistant();
          if (typeof window.viddelTrack === "function") {
            window.viddelTrack("chat_answer_error", { entry_surface: entrySurface, error_code: "network_error" });
          }
          showError("Nettverksfeil. Sjekk tilkoblingen og prøv igjen.");
        } finally {
          isSending = false;
          input.disabled = false;
          refreshSendState();
          setLoading(false);
          input.focus();
          syncComposeReserve();
        }
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        submitIfReady();
      });

      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          submitIfReady();
        }
      });

      for (const eventName of ["input", "change", "keyup", "compositionend", "paste", "cut"]) {
        input.addEventListener(eventName, handleComposerInput);
      }

      removeBtn.addEventListener("click", () => {
        clearError();
        clearAttachment();
      });

      const resetCapabilitiesMenu = () => {
        capabilitiesRoot.classList.remove("hidden");
        imagePanel.classList.add("hidden");
        questionPanel.classList.add("hidden");
      };

      const attachmentMenu = initChatAttachmentMenu(
        {
          attachLayer,
          attachBtn,
          attachMenu,
          attachBackdrop,
          attachCameraBtn,
          attachPickBtn,
          fileInput,
          composeStack,
        },
        {
          onFileSelected: (file) => {
            setAttachment(file);
            syncComposeReserve();
          },
          onClose: resetCapabilitiesMenu,
        },
      );

      const showCapabilitiesPanel = (panel: HTMLElement, focusTarget: HTMLButtonElement) => {
        capabilitiesRoot.classList.add("hidden");
        imagePanel.classList.toggle("hidden", panel !== imagePanel);
        questionPanel.classList.toggle("hidden", panel !== questionPanel);
        requestAnimationFrame(() => {
          attachmentMenu.refreshPosition();
          focusTarget.focus();
        });
      };

      imageTrigger.addEventListener("click", () => {
        const focusTarget = window.matchMedia("(max-width: 639px)").matches ? attachCameraBtn : attachPickBtn;
        showCapabilitiesPanel(imagePanel, focusTarget);
      });

      questionTrigger.addEventListener("click", () => {
        const firstQuestion = questionPanel.querySelector<HTMLButtonElement>("[data-viddel-chat-seed]");
        if (firstQuestion) showCapabilitiesPanel(questionPanel, firstQuestion);
      });

      capabilitiesBackButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const focusTarget = button.closest("[data-viddel-chat-question-panel]") ? questionTrigger : imageTrigger;
          resetCapabilitiesMenu();
          requestAnimationFrame(() => {
            attachmentMenu.refreshPosition();
            focusTarget.focus();
          });
        });
      });

      seedButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const question = button.getAttribute("data-viddel-chat-seed")?.trim() ?? "";
          if (!question) return;
          input.value = question;
          selectedGuideSeed = question;
          handleComposerInput();
          if (button.closest(".viddel-chat-internal-guide")) {
            window.dispatchEvent(new CustomEvent("vox-inspect-drawer-force-close"));
          } else if (button.closest("[data-viddel-chat-question-panel]")) {
            attachmentMenu.close();
          }
          input.focus();
          input.setSelectionRange(question.length, question.length);
        });
      });

      feedbackTrigger.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("viddel-conversation-feedback-open", {
          detail: { trigger: feedbackTrigger },
        }));
      });

      if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(() => {
          syncComposeReserve();
          updateSendState();
        });
        observer.observe(composeStack);
        if (startGroup) observer.observe(startGroup);
        observer.observe(scrollViewport);
        observer.observe(input);
      }

      window.addEventListener("resize", () => {
        syncComposeReserve();
        updateSendState();
      }, { passive: true });

      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", () => {
          syncComposeReserve();
          updateSendState();
        }, { passive: true });
      }

      if (pendingSeed) {
        input.value = pendingSeed;
        handleComposerInput();
        window.setTimeout(() => {
          if (pendingSeed) {
            sendMessage(pendingSeed);
            pendingSeed = "";
          }
        }, 120);
      } else {
        input.focus();
      }

      updateSendState();
      syncComposeReserve();
    })();
  </script>
</BaseLayout>
