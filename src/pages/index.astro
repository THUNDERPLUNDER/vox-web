---
/* CONTRACT: Public company homepage at viddel.no. Product MVP remains separate under /no. */
import PublicHoldingLayout from "../layouts/PublicHoldingLayout.astro";

const pageTitle = "Viddel – hør mer av hverdagen";
const pageDescription =
  "Viddel utvikler en norsk digital tjeneste som skal gjøre det lettere å forstå og mestre hørsel, lyd og teknologi i hverdagen.";
---

<PublicHoldingLayout title={pageTitle} description={pageDescription} canonical="https://www.viddel.no/">
  <main class="public-page">
    <header class="public-page__hero">
      <span class="public-page__signal" aria-hidden="true"></span>
      <h1>Hør mer av hverdagen</h1>
      <p class="public-page__lead"><strong>Viddel utvikler en norsk digital tjeneste for mennesker med svekket hørsel.</strong></p>
      <p class="public-page__lead">Vi vil gjøre det lettere å forstå hva som skjer, mestre lyd og teknologi i hverdagen og få mer ut av hjelpen som allerede finnes.</p>
    </header>

    <section class="public-section" aria-labelledby="mellom-timene-title">
      <h2 id="mellom-timene-title">Hverdagen skjer mellom timene</h2>
      <div class="public-section__body">
        <p>Det er hjemme, på jobb, i bilen og rundt middagsbordet at hørselen virkelig merkes.</p>
        <p>Der oppstår spørsmål om samtaler, støy, energi, høreapparater, mobil og TV. Og spørsmål du kanskje først kommer på etter timen hos audiografen.</p>
        <p>Viddel samler kunnskap og praktisk hjelp rundt disse situasjonene.</p>
      </div>
    </section>

    <section class="public-section" aria-labelledby="bygger-tester-title">
      <h2 id="bygger-tester-title">Vi bygger og tester nå</h2>
      <div class="public-section__body">
        <p>Vi utvikler Viddel sammen med brukere og fagmiljøer.</p>
        <p>KI hjelper oss å gjøre relevant kunnskap lettere tilgjengelig og mer tilpasset situasjonen. Råd om diagnose, behandling og individuell tilpasning overlater vi til fagfolkene.</p>
        <p>Den første versjonen er under utvikling og forberedes for testing.</p>
      </div>
    </section>

    <section class="public-section public-section--contact" aria-labelledby="kontakt-title">
      <h2 id="kontakt-title">Vil du vite mer, teste eller samarbeide med oss?</h2>
      <div class="public-section__body">
        <p><a href="mailto:kontakt@viddel.no">kontakt@viddel.no</a></p>
      </div>
    </section>
  </main>
</PublicHoldingLayout>
