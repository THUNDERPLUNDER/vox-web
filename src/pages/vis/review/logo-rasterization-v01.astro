---
/* CONTRACT: Temporary logo rasterization review for #121. Preview asset only; never canonical. */
import VisInternalLayout from "../../../layouts/VisInternalLayout.astro";
import LogoColorSignalReview from "../../../components/vis/LogoColorSignalReview.astro";

const base = import.meta.env.BASE_URL;
const logoSrc = `${base}brand/preview/viddel-wordmark-5bar-preview.svg`;
const ySrc = `${base}brand/preview/viddel-wordmark-small-5bar-20px-candidate-y-thin.svg`;
const yGeometricPrecisionSrc = `${base}brand/preview/viddel-wordmark-small-5bar-20px-candidate-y-thin-geometric-precision.svg`;
const variants = [
  { id: "primary", label: "Primary", detail: "referanse · 5 stolper", src: logoSrc, width: 938, height: 134 },
  { id: "a", label: "A", detail: "3 px · 3 stolper", src: `${base}brand/preview/viddel-wordmark-small-3bar-20px-candidate-a.svg`, width: 140, height: 20 },
  { id: "b", label: "B", detail: "2 px · 3 stolper", src: `${base}brand/preview/viddel-wordmark-small-3bar-20px-candidate-b-thin.svg`, width: 140, height: 20 },
  { id: "x", label: "X", detail: "3 px · 5 stolper", src: `${base}brand/preview/viddel-wordmark-small-5bar-20px-candidate-x.svg`, width: 140, height: 20 },
  { id: "y", label: "Y", detail: "2 px · 5 stolper", src: ySrc, width: 140, height: 20 },
];
const yOriginControls = [
  { label: "Standard", detail: "Naturlig plassering · SVG auto", src: ySrc, snap: false },
  { label: "Snappet", detail: "Hel CSS-piksel · SVG auto", src: ySrc, snap: true },
  { label: "Geometric", detail: "Naturlig plassering · geometricPrecision", src: yGeometricPrecisionSrc, snap: false },
  { label: "Begge", detail: "Hel CSS-piksel · geometricPrecision", src: yGeometricPrecisionSrc, snap: true },
];
const comparisonSizes = [8, 10, 12, 14, 16, 18, 20, 22, 24];
const sizes = [16, 18, 20, 22, 24, 26, 28, 30, 32];
const mobileHeaderCases = [
  { label: "Small Y", size: 20, src: ySrc, width: 140, height: 20, selected: true, status: "Valgt" },
  { label: "Primary", size: 22, src: logoSrc, width: 938, height: 134 },
  { label: "Primary", size: 24, src: logoSrc, width: 938, height: 134 },
];
const desktopHeaderCases = [
  { label: "Y · kontroll", size: 20, src: ySrc, width: 140, height: 20 },
  { label: "Primary", size: 22, src: logoSrc, width: 938, height: 134, selected: true, status: "Valgt" },
  { label: "Primary", size: 24, src: logoSrc, width: 938, height: 134 },
  { label: "Primary", size: 26, src: logoSrc, width: 938, height: 134 },
];
const viewBoxWidth = 937.88;
const viewBoxHeight = 134;
const referenceStemWidth = 15.57;
const signalBarWidth = 8.96;

const metricsFor = (height: number) => ({
  width: (height * viewBoxWidth) / viewBoxHeight,
  stem: (height * referenceStemWidth) / viewBoxHeight,
  signal: (height * signalBarWidth) / viewBoxHeight,
});

const format = (value: number) => value.toFixed(2);
---

<VisInternalLayout title="Logo rasterization review v0.1" pageContractId="review">
  <main class="logo-lab" data-logo-rasterization-review>
    <nav class="logo-lab__breadcrumb" aria-label="Du er her">
      <a href={`${base}vis/review/`}>Viddel Review</a>
      <span aria-hidden="true">/</span>
      <span>Logo rasterization v0.1</span>
    </nav>

    <header class="logo-lab__hero">
      <p class="logo-lab__kicker">#121 · arbeids- og beslutningsflate · 2026-08-24</p>
      <h1>Logo rasterization review</h1>
      <p>
        Sammenligner Primary med fire Small Optical-kandidater: 2 eller 3 px hovedstammer og 3
        eller 5 signalstolper. Størrelsesbeslutningen er nå implementert; nye farge- og signalavledninger er fortsatt preview-materiale.
      </p>
      <dl class="logo-lab__runtime" aria-label="Runtimeinformasjon">
        <div><dt>Device pixel ratio</dt><dd data-device-pixel-ratio>—</dd></div>
        <div><dt>Viewport</dt><dd data-viewport-size>—</dd></div>
        <div><dt>Browser zoom</dt><dd>Test ved 100 %</dd></div>
      </dl>
    </header>

    <section class="logo-lab__decision" aria-labelledby="decision-heading">
      <div>
        <p class="logo-lab__kicker">Arbeidsbeslutning</p>
        <h2 id="decision-heading">Tre optiske bruksområder er avgrenset</h2>
      </div>
      <ul>
        <li><strong>8–16 px:</strong> Variant A · 3 px hovedstammer · 3 signalstolper.</li>
        <li><strong>18–20 px:</strong> Variant Y · 2 px hovedstammer · 5 signalstolper.</li>
        <li><strong>22 px og opp:</strong> Primary ivaretar den delikate signalvekten.</li>
        <li><strong>Header:</strong> Primary 22 px på desktop; Small Y 20 px på mobil er godkjent og implementert.</li>
        <li>Micro A, Small Y og Primary er source-verifisert og ligger som canonical web-assets.</li>
        <li>Alle tre bruker avtalt navy <strong>#0F1B2E</strong> og blue <strong>#3672E6</strong>.</li>
      </ul>
    </section>

    <section class="logo-lab__section" aria-labelledby="candidate-comparison-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">Variantfelt · faktisk CSS-høyde</p>
          <h2 id="candidate-comparison-heading">Fem geometrier fra 8 til 24 px</h2>
        </div>
        <p>Samme CSS-høyde og naturlig plassering. Vurder ved 100 % zoom; 20 px er eneste 1:1-grid.</p>
      </header>

      <div class="candidate-matrix">
        {comparisonSizes.map((size) => (
          <article class:list={["candidate-size", size === 20 && "candidate-size--nominal"]}>
            <header class="logo-sample__head">
              <div>
                <h3>{size} px</h3>
                {size === 20 ? <span>Nominell</span> : null}
              </div>
              <p>{size < 16 ? "mikro stress-test" : size === 20 ? "1:1 pixel-grid" : "skalert"}</p>
            </header>
            <div class="candidate-size__variants">
              {variants.map((variant) => (
                <figure>
                  <div class="candidate-size__stage" data-logo-stage>
                    <img
                      src={variant.src}
                      alt={`VIDDEL ${variant.label}, ${variant.detail}, ved ${size} piksler`}
                      width={variant.width}
                      height={variant.height}
                      style={`height: ${size}px`}
                      data-logo-render
                    />
                  </div>
                  <figcaption>
                    <strong>{variant.label}</strong> · {variant.detail}<br />
                    <span data-origin-readout>—</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="logo-lab__section" aria-labelledby="origin-control-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">Y · 20 px · rasteriseringskontroll</p>
          <h2 id="origin-control-heading">Origin-snapping mot geometricPrecision</h2>
        </div>
        <p>
          Samme vektorgeometri og størrelse i alle fire felt. Bare plasseringen av SVG-elementet og
          root-attributtet <code>shape-rendering</code> varierer.
        </p>
      </header>

      <div class="origin-control-grid">
        {yOriginControls.map((control) => (
          <figure class="origin-control">
            <div class="origin-control__stage">
              <img
                src={control.src}
                alt={`VIDDEL Y ved 20 piksler, ${control.detail}`}
                width="140"
                height="20"
                data-logo-render
                data-origin-snap={control.snap ? "true" : undefined}
              />
            </div>
            <figcaption>
              <strong>{control.label}</strong><br />
              {control.detail}<br />
              <span data-origin-readout>—</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="origin-control__note">
        Snappingen bruker målt <code>left/top</code>-korreksjon kun som diagnostikk. Den er ikke en
        foreslått produksjonsimplementasjon. Vurder V-diagonalene, begge D-buene og de fem signalstolpene
        ved 100 % zoom.
      </p>
    </section>

    <section class="logo-lab__section" aria-labelledby="size-matrix-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">1:1 CSS-piksler</p>
          <h2 id="size-matrix-heading">Størrelsesmatrise</h2>
        </div>
        <p>Vurder ved normal zoom. Signalbredde under 2 CSS-px vil nødvendigvis antialiases på 1×.</p>
      </header>

      <div class="logo-matrix">
        {sizes.map((size) => {
          const metrics = metricsFor(size);
          const isCandidate = size === 20 || size === 24;
          return (
            <article class:list={["logo-sample", isCandidate && "logo-sample--candidate"]}>
              <header class="logo-sample__head">
                <div>
                  <h3>{size} px</h3>
                  {isCandidate ? <span>Kandidat</span> : null}
                </div>
                <p>{format(metrics.width)} px bred</p>
              </header>

              <div class="logo-sample__renders">
                <figure>
                  <div class="logo-sample__stage" data-logo-stage>
                    <img
                      src={logoSrc}
                      alt={`VIDDEL Primary 5-bar ved ${size} piksler`}
                      width="938"
                      height="134"
                      style={`height: ${size}px`}
                      data-logo-render
                    />
                  </div>
                  <figcaption>Naturlig plassering · <span data-origin-readout>—</span></figcaption>
                </figure>
                <figure>
                  <div class="logo-sample__stage" data-logo-stage>
                    <img
                      src={logoSrc}
                      alt={`VIDDEL Primary 5-bar ved ${size} piksler, forskjøvet en halv piksel`}
                      width="938"
                      height="134"
                      style={`height: ${size}px; transform: translateX(0.5px)`}
                      data-logo-render
                    />
                  </div>
                  <figcaption>+0,5 px forskyvning · <span data-origin-readout>—</span></figcaption>
                </figure>
              </div>

              <dl class="logo-sample__metrics">
                <div><dt>Referansestamme</dt><dd>{format(metrics.stem)} CSS-px</dd></div>
                <div><dt>Signalstolpe</dt><dd>{format(metrics.signal)} CSS-px</dd></div>
              </dl>
            </article>
          );
        })}
      </div>
    </section>

    <section class="logo-lab__section" aria-labelledby="header-context-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">Beslutningsport · reell bruk</p>
          <h2 id="header-context-heading">Primary i faktisk headerhøyde</h2>
        </div>
        <p>
          Valgt nå: Y ved 20 px i 64 px mobilheader og Primary ved 22 px i 72 px desktopheader.
          Dette dokumenterer den nå implementerte responsive headerbeslutningen.
        </p>
      </header>

      <div class="header-contexts">
        <section class="header-context" aria-labelledby="mobile-header-heading">
          <header class="header-context__head">
            <div>
              <p class="logo-lab__kicker">Mobil · 64 px header</p>
              <h3 id="mobile-header-heading">20 / 22 / 24 px</h3>
            </div>
            <p>Small Y 20 px er valgt. Den er 140 px bred og kan revurderes senere hvis portrettbredden blir knapp.</p>
          </header>
          <div class="header-context__stack header-context__stack--mobile">
            {mobileHeaderCases.map((sample) => (
              <figure class:list={["header-sample", sample.selected && "header-sample--candidate"]}>
                <figcaption>
                  <strong>{sample.label}</strong>
                  <span>{sample.size} px</span>
                  {sample.status ? <em>{sample.status}</em> : null}
                </figcaption>
                <div class="header-sample__viewport header-sample__viewport--mobile">
                  <a href="#mobile-header-heading" aria-label={`Viddel ${sample.size} piksler`}>
                    <img
                      src={sample.src}
                      alt=""
                      width={sample.width}
                      height={sample.height}
                      style={`height: ${sample.size}px`}
                      data-logo-render
                    />
                  </a>
                  <button type="button" aria-label="Eksempel på mobilmeny" tabindex="-1">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                  </button>
                </div>
              </figure>
            ))}
          </div>
        </section>

        <section class="header-context" aria-labelledby="desktop-header-heading">
          <header class="header-context__head">
            <div>
              <p class="logo-lab__kicker">Desktop · 72 px header</p>
              <h3 id="desktop-header-heading">20 / 22 / 24 / 26 px</h3>
            </div>
            <p>Primary 22 px er valgt. Den gir mer nærvær uten å bli dominerende mot navigasjonen.</p>
          </header>
          <div class="header-context__stack header-context__stack--desktop">
            {desktopHeaderCases.map((sample) => (
              <figure class:list={["header-sample", sample.selected && "header-sample--candidate"]}>
                <figcaption>
                  <strong>{sample.label}</strong>
                  <span>{sample.size} px</span>
                  {sample.status ? <em>{sample.status}</em> : null}
                </figcaption>
                <div class="header-sample__desktop-scroll">
                  <div class="header-sample__viewport header-sample__viewport--desktop">
                    <a href="#desktop-header-heading" aria-label={`Viddel ${sample.size} piksler`}>
                      <img
                        src={sample.src}
                        alt=""
                        width={sample.width}
                        height={sample.height}
                        style={`height: ${sample.size}px`}
                        data-logo-render
                      />
                    </a>
                    <nav aria-label="Eksempel på desktopnavigasjon">
                      <span class="is-active">Forside</span>
                      <span>Hjelp</span>
                      <span>Bedre lyd</span>
                      <span>Ordbok</span>
                      <span>Om Viddel</span>
                    </nav>
                    <span class="header-sample__cta">Spør Viddel</span>
                  </div>
                </div>
              </figure>
            ))}
          </div>
        </section>
      </div>

      <p class="header-context__note">
        Dette er historisk størrelsesgrunnlag for den implementerte headeren. Preview-eksemplene er fortsatt testmateriale.
      </p>
    </section>

    <section class="logo-lab__section" aria-labelledby="canonical-gate-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">Neste godkjenningsport</p>
          <h2 id="canonical-gate-heading">Låste wordmark-assets</h2>
        </div>
        <p>Den eldre totallsmodellen i #121 er erstattet av tre eksplisitte, source-verifiserte wordmark-geometrier.</p>
      </header>
      <div class="canonical-gate">
        <div>
          <h3>QA-status for canonical wordmarks</h3>
          <ul>
            <li>Primary, A og Y er rene vektorer uten tekst, font eller rasterbilder.</li>
            <li>A og Y har tett <code>viewBox="0 0 140 20"</code> og eksplisitt 140 × 20-størrelse.</li>
            <li>Canonical assets bruker navy <strong>#0F1B2E</strong> og blue <strong>#3672E6</strong>.</li>
            <li>Headermappingen er Small Y 20 px på mobil og Primary 22 px på desktop.</li>
          </ul>
        </div>
        <div>
          <h3>Canonical filnavn</h3>
          <dl>
            <div><dt>Primary · 5 stolper</dt><dd><code>viddel-wordmark-primary-5bar.svg</code></dd></div>
            <div><dt>Small · Y · 5 stolper</dt><dd><code>viddel-wordmark-small-5bar.svg</code></dd></div>
            <div><dt>Micro · A · 3 stolper</dt><dd><code>viddel-wordmark-micro-3bar.svg</code></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="logo-lab__section logo-lab__reference" aria-labelledby="material-reference-heading">
      <header class="logo-lab__section-head">
        <div>
          <p class="logo-lab__kicker">Referanseprinsipp</p>
          <h2 id="material-reference-heading">Lærdom fra Material Symbols</h2>
        </div>
      </header>
      <p>
        Google bruker optiske størrelser fra 20 til 48 px og oppgir at 20- og 24-pikselvariantene
        er de som er tegnet med perfekt pixel-grid alignment. For Viddel betyr det en egen Small
        Optical-geometri rundt én valgt målstørrelse, ikke tilfeldig skalering av Primary.
      </p>
      <div class="logo-lab__reference-links">
        <a href="https://developers.google.com/fonts/docs/material_symbols?hl=en">Material Symbols guide</a>
        <a href="https://github.com/google/material-design-icons">Offisielt icon-repo</a>
      </div>
    </section>

    <LogoColorSignalReview />

    <footer class="logo-lab__footer">
      <strong>Aktiv beslutningsport:</strong> Signal green/white er valgt for faviconsporet. Sammenlign
      Micro 3 og Micro 5 på full 16×16-flate og med én transparent høyrepiksel. Produksjonsfavicon er
      ikke endret, og #121 forblir åpen.
    </footer>
  </main>
</VisInternalLayout>

<script>
  const fractionFor = (value: number) => ((value % 1) + 1) % 1;

  const snapLogoOrigins = () => {
    document.querySelectorAll<HTMLElement>("[data-origin-snap]").forEach((logo) => {
      logo.style.left = "0px";
      logo.style.top = "0px";
      const rect = logo.getBoundingClientRect();
      logo.style.left = `${Math.round(rect.x) - rect.x}px`;
      logo.style.top = `${Math.round(rect.y) - rect.y}px`;
    });
  };

  const updateRuntimeReadouts = () => {
    snapLogoOrigins();
    const dpr = window.devicePixelRatio || 1;
    document.querySelectorAll<HTMLElement>("[data-device-pixel-ratio]").forEach((element) => {
      element.textContent = `${dpr.toFixed(2)}×`;
    });
    document.querySelectorAll<HTMLElement>("[data-viewport-size]").forEach((element) => {
      element.textContent = `${window.innerWidth} × ${window.innerHeight}`;
    });
    document.querySelectorAll<HTMLElement>("[data-logo-render]").forEach((logo) => {
      const readout = logo.closest("figure")?.querySelector<HTMLElement>("[data-origin-readout]");
      if (!readout) return;
      const rect = logo.getBoundingClientRect();
      const xFraction = fractionFor(rect.x);
      const yFraction = fractionFor(rect.y);
      readout.textContent = `x ${xFraction.toFixed(2)} · y ${yFraction.toFixed(2)}`;
    });
  };

  updateRuntimeReadouts();
  window.addEventListener("resize", updateRuntimeReadouts, { passive: true });
</script>

<style>
  [data-logo-rasterization-review] {
    --lab-ink: #0f1b2e;
    --lab-blue: #3672e6;
    --lab-muted: #667085;
    --lab-border: #dce1e8;
    --lab-paper: #ffffff;
    max-width: 76rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    color: var(--lab-ink);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .logo-lab__breadcrumb {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--lab-muted);
    font-size: 0.78rem;
  }

  .logo-lab__breadcrumb a,
  .logo-lab__reference-links a {
    color: var(--lab-blue);
    text-underline-offset: 0.18em;
  }

  .logo-lab__hero {
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--lab-border);
    border-radius: 0.85rem;
    background: var(--lab-paper);
  }

  .logo-lab__kicker {
    margin: 0;
    color: var(--lab-blue);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .logo-lab h1,
  .logo-lab h2,
  .logo-lab h3,
  .logo-lab p {
    margin-top: 0;
  }

  .logo-lab h1 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .logo-lab__hero > p:not(.logo-lab__kicker) {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--lab-muted);
    line-height: 1.65;
  }

  .logo-lab__runtime,
  .logo-sample__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.25rem 0 0;
  }

  .logo-lab__runtime div,
  .logo-sample__metrics div {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--lab-border);
    border-radius: 0.55rem;
    background: #f8fafc;
  }

  .logo-lab dt,
  .logo-lab dd {
    margin: 0;
  }

  .logo-lab dt {
    color: var(--lab-muted);
    font-size: 0.7rem;
  }

  .logo-lab dd {
    margin-top: 0.2rem;
    font-size: 0.84rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .logo-lab__decision {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgb(54 114 230 / 0.26);
    border-radius: 0.75rem;
    background: rgb(54 114 230 / 0.055);
  }

  .logo-lab__decision h2,
  .logo-lab__section h2 {
    margin: 0.25rem 0 0;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .logo-lab__decision ul {
    margin: 0;
    padding-left: 1.1rem;
    color: #475467;
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .logo-lab__section {
    margin-top: 2rem;
  }

  .logo-lab__section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 0.9rem;
  }

  .logo-lab__section-head > p {
    max-width: 35rem;
    margin-bottom: 0;
    color: var(--lab-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .logo-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0.85rem;
  }

  .candidate-matrix {
    display: grid;
    gap: 0.85rem;
  }

  .candidate-size {
    overflow: hidden;
    border: 1px solid var(--lab-border);
    border-radius: 0.75rem;
    background: var(--lab-paper);
  }

  .candidate-size--nominal {
    border-color: rgb(54 114 230 / 0.55);
    box-shadow: 0 0 0 2px rgb(54 114 230 / 0.08);
  }

  .candidate-size__variants {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .candidate-size__variants figure {
    min-width: 0;
    margin: 0;
  }

  .candidate-size__variants figure + figure {
    border-left: 1px solid var(--lab-border);
  }

  .candidate-size__stage {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    overflow: hidden;
    padding: 0.85rem;
    background-color: #fff;
    background-image:
      linear-gradient(rgb(15 27 46 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(15 27 46 / 0.04) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .candidate-size figcaption {
    min-height: 3.2rem;
