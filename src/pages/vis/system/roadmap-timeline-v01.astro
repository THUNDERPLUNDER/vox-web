---
/* CONTRACT: VIS Horizon Roadmap v0.1 — curated Project Brain direction joined to separate live GitHub task status. */
import VisInternalLayout from "../../../layouts/VisInternalLayout.astro";
import RoadmapInitiativeCard from "../../../components/vis/RoadmapInitiativeCard.astro";
import {
  roadmapDecisionForks,
  githubIssueHref,
  roadmapHorizons,
  roadmapInitiatives,
  roadmapProgramFrame,
  roadmapProjectionMeta,
  roadmapTracks,
  roadmapWatchSignals,
  type RoadmapInitiative,
  type RoadmapTrackId,
} from "../../../data/vis-roadmap-horizons-v01.ts";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const shapingCommentHref = `https://github.com/THUNDERPLUNDER/vox-web/issues/${roadmapProjectionMeta.shapingIssue}#issuecomment-${roadmapProjectionMeta.shapingCommentId}`;

type Placement = { initiative: RoadmapInitiative; column: number; span: number; row: number };

function placeInitiatives(track: RoadmapTrackId): Placement[] {
  const horizonOrder = ["now", "next", "later"] as const;
  const nextFreeRow = [1, 1, 1];
  return roadmapInitiatives
    .filter((initiative) => initiative.track === track)
    .sort((a, b) => a.projectionOrder - b.projectionOrder)
    .map((initiative) => {
      const column = horizonOrder.indexOf(initiative.horizons[0]!);
      const span = initiative.horizons.length;
      const row = Math.max(...nextFreeRow.slice(column, column + span));
      for (let index = column; index < column + span; index += 1) nextFreeRow[index] = row + 1;
      return { initiative, column: column + 1, span, row };
    });
}

const mobileInitiatives = roadmapHorizons.map((horizon) => ({
  ...horizon,
  initiatives: roadmapInitiatives
    .filter((initiative) => initiative.horizons[0] === horizon.id)
    .sort((a, b) => a.projectionOrder - b.projectionOrder),
}));
---

<VisInternalLayout title="Viddel Horizon Roadmap v0.1" pageContractId="roadmap" showPageIntro={false}>
  <main class="roadmap-page">
    <nav class="roadmap-breadcrumb" aria-label="Du er her">
      <a href={`${base}vis`}>VIS</a><span aria-hidden="true">/</span><span>Roadmap</span>
    </nav>

    <header class="roadmap-hero">
      <p class="roadmap-eyebrow">Project Brain projection · {roadmapProjectionMeta.version}</p>
      <h1>{roadmapProjectionMeta.title}</h1>
      <p class="roadmap-hero__lead">
        En redaksjonell prognose for retning og porter — ikke kalenderplan eller task-backlog.
        Les fra <strong>NOW</strong> mot <strong>NEXT</strong> og <strong>LATER</strong>; følg <strong>WATCH</strong> som eget signallag.
      </p>
      <div class="roadmap-source">
        <p>
          <strong>{roadmapProjectionMeta.sourceDocument}</strong> eier strategisk retning.
          GitHub eier task- og runtime-status. VIS kobler kildene uten å gjøre dem til samme signal.
        </p>
        <a href={shapingCommentHref} rel="noopener noreferrer">Åpne shaping-kilden i #374</a>
      </div>
    </header>

    <section class="roadmap-forecast" aria-labelledby="forecast-title">
      <div class="roadmap-section-heading">
        <div>
          <p class="roadmap-eyebrow">Retning</p>
          <h2 id="forecast-title">NOW <span aria-hidden="true">→</span> NEXT <span aria-hidden="true">→</span> LATER</h2>
        </div>
        <p>Ingen dato vises før en virkelig dato eller et reelt vindu er etablert.</p>
      </div>

      <div class="roadmap-desktop" aria-label="Roadmap etter strategisk spor og horizon">
        <div class="roadmap-axis">
          <p>Spor</p>
          {roadmapHorizons.map((horizon) => (
            <div>
              <strong>{horizon.label}</strong>
              <span>{horizon.description}</span>
            </div>
          ))}
        </div>

        {roadmapTracks.map((track) => (
          <section class="roadmap-track" aria-labelledby={`track-${track.id}`}>
            <header>
              <span>{track.code}</span>
              <h3 id={`track-${track.id}`}>{track.label}</h3>
            </header>
            <div class="roadmap-track__grid">
              <span class="roadmap-track__guide roadmap-track__guide--one" aria-hidden="true"></span>
              <span class="roadmap-track__guide roadmap-track__guide--two" aria-hidden="true"></span>
              {placeInitiatives(track.id).map(({ initiative, column, span, row }) => (
                <div style={`grid-column: ${column} / span ${span}; grid-row: ${row};`}>
                  <RoadmapInitiativeCard initiative={initiative} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="roadmap-mobile" aria-label="Roadmap etter horizon">
        {mobileInitiatives.map((horizon) => (
          <section aria-labelledby={`mobile-${horizon.id}`}>
            <header>
              <p class="roadmap-eyebrow">Horizon</p>
              <h3 id={`mobile-${horizon.id}`}>{horizon.label}</h3>
              <p>{horizon.description}</p>
            </header>
            <div class="roadmap-mobile__items">
              {horizon.initiatives.map((initiative) => (
                <RoadmapInitiativeCard
                  initiative={initiative}
                  trackCode={roadmapTracks.find((track) => track.id === initiative.track)?.code}
                />
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="roadmap-supporting-source">
        <strong>Pull-basert støtte:</strong> <a href={githubIssueHref(339)} rel="noopener noreferrer">#339 kunnskapsoperasjon</a>
        aktiveres ved observert kunnskapsgap eller freshness-behov og er derfor ikke et eget toppnivåobjekt.
      </p>
    </section>

    <section class="roadmap-watch" aria-labelledby="watch-title">
      <div class="roadmap-watch__heading">
        <div>
          <p class="roadmap-eyebrow">Parallelt signallag</p>
          <h2 id="watch-title">WATCH</h2>
        </div>
        <p>Signaler kan endre gates eller prioritet. De er ikke et fjerde horizon og ikke planlagte leveranser.</p>
      </div>
      <div class="roadmap-watch__grid">
        {roadmapWatchSignals.map((signal) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{signal.title}</h3>
            <p>{signal.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="roadmap-context" aria-label="Roadmap-kontekst">
      <div>
        <p class="roadmap-eyebrow">Foreløpig programramme</p>
        <p>{roadmapProgramFrame}</p>
      </div>
      <div>
        <p class="roadmap-eyebrow">Synlige beslutningsforker</p>
        <ul role="list">
          {roadmapDecisionForks.map((fork) => (
            <li><strong>{fork.title}</strong><span>{fork.body}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <details class="roadmap-legend">
      <summary>Slik leser du roadmapet</summary>
      <div class="roadmap-legend__body">
        <section>
          <h2>Gjennomføringssignal</h2>
          <ul role="list">
            <li><span class="legend-line legend-line--committed"></span><strong>Forpliktet</strong> — valgt retning eller aktiv avklaring.</li>
            <li><span class="legend-line legend-line--probable"></span><strong>Sannsynlig</strong> — forventet bevegelse, men ikke låst.</li>
            <li><span class="legend-line legend-line--conditional"></span><strong>Betinget</strong> — krever eksplisitt gate eller trigger.</li>
            <li><span class="legend-line legend-line--option"></span><strong>Mulighet</strong> — bevart, ikke planlagt.</li>
          </ul>
        </section>
        <section>
          <h2>Timing</h2>
          <ul role="list">
            <li><span class="legend-timing legend-timing--fixed"></span><strong>Fast</strong> — faktisk dato eller punkt.</li>
            <li><span class="legend-timing legend-timing--bounded"></span><strong>Avgrenset</strong> — definert, bredere vindu.</li>
            <li><span class="legend-timing legend-timing--open"></span><strong>Åpen</strong> — ingen etablert dato; åpen hale.</li>
          </ul>
        </section>
        <section>
          <h2>Relasjoner og metadata</h2>
          <ul role="list">
            <li><span class="legend-milestone" aria-hidden="true"></span><strong>Milepæl</strong> er et faktisk punkt eller vindu; ingen er datofestet i denne projeksjonen.</li>
            <li><span class="legend-dependency" aria-hidden="true"></span><strong>Avhengighet / gate</strong> forklarer hva som må være sant før bevegelse.</li>
            <li><strong>WATCH</strong> er signaler som kan endre retning, ikke et horizon.</li>
            <li><strong>LEASE / OWN / ECOSYSTEM</strong> er sekundær strategisk funksjon, synlig i detaljene.</li>
            <li><strong>GitHub-status</strong> er live task-drill-down og aldri et mål på likelihood eller timing.</li>
          </ul>
        </section>
      </div>
    </details>

    <footer class="roadmap-footer">
      <p>
        Projisert {roadmapProjectionMeta.projectionDate} · eier: {roadmapProjectionMeta.projectionOwner} ·
        kilde- og Operating Model-revisjoner er bundet i repo-projeksjonen.
      </p>
      <a href={`${base}vis`}>Tilbake til VIS Project State</a>
    </footer>
  </main>
</VisInternalLayout>

<script>
  type GitHubIssue = { number: number; state: "open" | "closed"; pull_request?: unknown };
  const endpoint = "https://api.github.com/repos/THUNDERPLUNDER/vox-web/issues?state=all&per_page=100&sort=updated";

  function setFallback() {
    document.querySelectorAll<HTMLElement>("[data-github-readiness-label]").forEach((node) => {
      node.textContent = "GitHub må åpnes for fersk status";
    });
  }

  async function hydrateGitHubStatus() {
    try {
      const response = await fetch(endpoint, { headers: { Accept: "application/vnd.github+json" } });
      if (!response.ok) throw new Error("GitHub-status utilgjengelig");
      const issues = (await response.json()) as GitHubIssue[];
      const issueByNumber = new Map(
        issues.filter((issue) => !issue.pull_request).map((issue) => [issue.number, issue]),
      );

      document.querySelectorAll<HTMLElement>("[data-github-issue-state]").forEach((node) => {
        const issueNumber = Number.parseInt(node.dataset.githubIssueState ?? "", 10);
        const issue = issueByNumber.get(issueNumber);
        node.textContent = issue ? (issue.state === "closed" ? "lukket" : "åpen") : "åpne GitHub";
      });

      document.querySelectorAll<HTMLElement>("[data-github-readiness]").forEach((container) => {
        const sourceIssues = (container.dataset.sourceIssues ?? "")
          .split(",")
          .map((value) => Number.parseInt(value, 10))
          .filter(Number.isFinite);
        const found = sourceIssues.map((issue) => issueByNumber.get(issue)).filter(Boolean) as GitHubIssue[];
        const label = container.querySelector<HTMLElement>("[data-github-readiness-label]");
        if (!label) return;
        if (found.length !== sourceIssues.length) label.textContent = "delvis tilgjengelig — bruk drill-down";
        else if (found.every((issue) => issue.state === "closed")) label.textContent = "alle kildespor lukket";
        else label.textContent = `${found.filter((issue) => issue.state === "open").length} åpne kildespor`;
      });
    } catch {
      setFallback();
    }
  }

  hydrateGitHubStatus();
</script>

<style is:global>
  .roadmap-page {
    --roadmap-ink: 15 27 46;
    --roadmap-muted: 82 96 113;
    --roadmap-line: 213 222 232;
    --roadmap-blue: 54 114 230;
    --roadmap-focus: 14 165 233;
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.35rem, 3vw, 2.5rem) clamp(0.85rem, 3vw, 2rem) 4rem;
    color: rgb(var(--roadmap-ink));
  }

  .roadmap-breadcrumb { display: flex; gap: 0.5rem; color: rgb(var(--roadmap-muted)); font-size: 0.75rem; }
  .roadmap-breadcrumb a, .roadmap-footer a, .roadmap-source a { color: rgb(35 83 173); }
  .roadmap-hero { max-width: 64rem; padding: clamp(1rem, 3vw, 2rem) 0 clamp(2rem, 5vw, 3.8rem); }
  .roadmap-eyebrow { margin: 0; color: rgb(var(--roadmap-muted)); font-size: 0.67rem; font-weight: 750; letter-spacing: 0.13em; text-transform: uppercase; }
  .roadmap-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.2rem, 6vw, 4.8rem); line-height: 0.98; letter-spacing: -0.05em; font-weight: 630; text-wrap: balance; }
  .roadmap-hero__lead { max-width: 52rem; margin: 1rem 0 0; color: rgb(var(--roadmap-muted)); font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.65; }
  .roadmap-source { display: flex; gap: 0.8rem 1.5rem; align-items: baseline; justify-content: space-between; max-width: 58rem; margin-top: 1.3rem; padding-top: 0.9rem; border-top: 1px solid rgb(var(--roadmap-line)); }
  .roadmap-source p { max-width: 45rem; margin: 0; color: rgb(var(--roadmap-muted)); font-size: 0.75rem; line-height: 1.55; }
  .roadmap-source a { flex: none; font-size: 0.72rem; font-weight: 650; }

  .roadmap-forecast { overflow: hidden; border: 1px solid rgb(190 205 221); border-radius: 1.25rem; background: linear-gradient(145deg, rgb(247 250 253), rgb(255 255 255)); box-shadow: 0 20px 60px rgb(15 27 46 / 0.07); }
  .roadmap-section-heading { display: flex; gap: 1rem; align-items: flex-end; justify-content: space-between; padding: clamp(1.1rem, 3vw, 1.8rem); border-bottom: 1px solid rgb(var(--roadmap-line)); }
  .roadmap-section-heading h2, .roadmap-watch h2 { margin: 0.35rem 0 0; font-size: clamp(1.45rem, 3vw, 2.2rem); letter-spacing: -0.035em; }
  .roadmap-section-heading > p { max-width: 26rem; margin: 0; color: rgb(var(--roadmap-muted)); font-size: 0.76rem; line-height: 1.5; text-align: right; }

  .roadmap-desktop { min-width: 64rem; }
  .roadmap-axis, .roadmap-track { display: grid; grid-template-columns: minmax(9rem, 0.58fr) repeat(3, minmax(15rem, 1fr)); }
  .roadmap-axis { position: sticky; top: 0; z-index: 4; border-bottom: 1px solid rgb(var(--roadmap-line)); background: rgb(247 250 253 / 0.96); backdrop-filter: blur(10px); }
  .roadmap-axis > p { margin: 0; padding: 0.8rem; color: rgb(var(--roadmap-muted)); font-size: 0.62rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .roadmap-axis > div { padding: 0.8rem 0.9rem; border-left: 1px solid rgb(var(--roadmap-line)); }
  .roadmap-axis strong, .roadmap-axis span { display: block; }
  .roadmap-axis strong { font-size: 0.78rem; letter-spacing: 0.08em; }
  .roadmap-axis span { max-width: 17rem; margin-top: 0.25rem; color: rgb(var(--roadmap-muted)); font-size: 0.64rem; line-height: 1.4; }
  .roadmap-track + .roadmap-track { border-top: 1px solid rgb(var(--roadmap-line)); }
  .roadmap-track > header { position: sticky; left: 0; z-index: 3; display: flex; gap: 0.6rem; align-items: baseline; padding: 1rem 0.8rem; background: rgb(249 251 253 / 0.96); }
  .roadmap-track > header span { color: rgb(var(--roadmap-blue)); font-size: 0.68rem; font-weight: 800; }
  .roadmap-track > header h3 { margin: 0; font-size: 0.78rem; line-height: 1.35; }
  .roadmap-track__grid { position: relative; display: grid; grid-column: 2 / -1; grid-template-columns: repeat(3, minmax(15rem, 1fr)); grid-auto-rows: minmax(min-content, auto); gap: 0.65rem; padding: 0.7rem; }
  .roadmap-track__grid > div { min-width: 0; }
  .roadmap-track__guide { position: absolute; top: 0; bottom: 0; width: 1px; background: rgb(var(--roadmap-line)); }
  .roadmap-track__guide--one { left: 33.333%; }
  .roadmap-track__guide--two { left: 66.666%; }

  .roadmap-mobile { display: none; }
  .roadmap-supporting-source { margin: 0; padding: 0.85rem 1rem; border-top: 1px solid rgb(var(--roadmap-line)); color: rgb(var(--roadmap-muted)); font-size: 0.68rem; line-height: 1.5; }
  .roadmap-supporting-source a { color: rgb(35 83 173); }

  .roadmap-watch { margin-top: 1.2rem; padding: clamp(1.1rem, 3vw, 1.8rem); border: 1px solid rgb(190 205 221); border-radius: 1.1rem; background: rgb(15 27 46); color: white; }
  .roadmap-watch .roadmap-eyebrow { color: rgb(169 191 220); }
  .roadmap-watch__heading { display: flex; gap: 1rem; align-items: end; justify-content: space-between; }
  .roadmap-watch__heading > p { max-width: 33rem; margin: 0; color: rgb(190 204 222); font-size: 0.76rem; line-height: 1.5; text-align: right; }
  .roadmap-watch__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 1.2rem; border-top: 1px solid rgb(255 255 255 / 0.18); }
  .roadmap-watch article { position: relative; padding: 1rem 0.9rem 0; }
  .roadmap-watch article + article { border-left: 1px solid rgb(255 255 255 / 0.12); }
  .roadmap-watch article > span { position: absolute; top: -0.2rem; left: 0.9rem; width: 0.42rem; height: 0.42rem; border-radius: 50%; background: rgb(105 160 255); box-shadow: 0 0 0 0.22rem rgb(105 160 255 / 0.15); }
  .roadmap-watch h3 { margin: 0; font-size: 0.8rem; line-height: 1.35; }
  .roadmap-watch article p { margin: 0.35rem 0 0; color: rgb(190 204 222); font-size: 0.69rem; line-height: 1.45; }

  .roadmap-context { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 1px; margin-top: 1.2rem; overflow: hidden; border: 1px solid rgb(var(--roadmap-line)); border-radius: 1rem; background: rgb(var(--roadmap-line)); }
  .roadmap-context > div { padding: 1.1rem; background: rgb(255 255 255 / 0.82); }
  .roadmap-context p:not(.roadmap-eyebrow) { margin: 0.55rem 0 0; color: rgb(var(--roadmap-muted)); font-size: 0.78rem; line-height: 1.55; }
  .roadmap-context ul { display: grid; gap: 0.75rem; margin: 0.6rem 0 0; padding: 0; list-style: none; }
  .roadmap-context li { display: grid; gap: 0.2rem; }
  .roadmap-context li strong { font-size: 0.76rem; }
  .roadmap-context li span { color: rgb(var(--roadmap-muted)); font-size: 0.72rem; line-height: 1.48; }

  .roadmap-legend { margin-top: 1.2rem; border-top: 1px solid rgb(var(--roadmap-line)); border-bottom: 1px solid rgb(var(--roadmap-line)); }
  .roadmap-legend > summary { padding: 1rem 0; color: rgb(var(--roadmap-ink)); font-size: 0.86rem; font-weight: 680; cursor: pointer; }
  .roadmap-legend__body { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.3rem; padding: 0 0 1.3rem; }
  .roadmap-legend h2 { margin: 0 0 0.6rem; font-size: 0.77rem; }
  .roadmap-legend ul { display: grid; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }
  .roadmap-legend li { color: rgb(var(--roadmap-muted)); font-size: 0.7rem; line-height: 1.48; }
  .roadmap-legend li strong { color: rgb(var(--roadmap-ink)); }
  .legend-line, .legend-timing { display: inline-block; width: 1.5rem; margin-right: 0.4rem; vertical-align: 0.15rem; border-top: 3px solid rgb(var(--roadmap-blue)); }
  .legend-line--probable { opacity: 0.7; }
  .legend-line--conditional { opacity: 0.58; border-top-style: dashed; }
  .legend-line--option { opacity: 0.4; border-top-style: dotted; }
  .legend-timing { border-top-width: 1px; }
  .legend-timing--fixed { width: 0.5rem; border-top-width: 4px; }
  .legend-timing--bounded { width: 2rem; }
  .legend-timing--open { border-top-style: dotted; mask-image: linear-gradient(to right, black, transparent); }
  .legend-milestone { display: inline-block; width: 0.5rem; height: 0.5rem; margin-right: 0.55rem; border: 2px solid rgb(var(--roadmap-blue)); border-radius: 50%; vertical-align: -0.02rem; }
  .legend-dependency { display: inline-block; width: 1.2rem; margin-right: 0.45rem; border-top: 1px dashed rgb(var(--roadmap-blue)); vertical-align: 0.18rem; }

  .roadmap-footer { display: flex; gap: 1rem; align-items: baseline; justify-content: space-between; padding-top: 1.4rem; }
  .roadmap-footer p { max-width: 50rem; margin: 0; color: rgb(var(--roadmap-muted)); font-size: 0.68rem; line-height: 1.5; }
  .roadmap-footer a { flex: none; font-size: 0.75rem; font-weight: 650; }

  @media (max-width: 1120px) {
    .roadmap-forecast { overflow-x: auto; }
    .roadmap-watch__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .roadmap-watch article:nth-child(odd) { border-left: 0; }
    .roadmap-watch article:nth-child(n + 3) { margin-top: 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.12); }
  }

  @media (max-width: 720px) {
    .roadmap-hero { padding-bottom: 2.1rem; }
    .roadmap-source, .roadmap-section-heading, .roadmap-watch__heading, .roadmap-footer { align-items: flex-start; flex-direction: column; }
    .roadmap-section-heading > p, .roadmap-watch__heading > p { text-align: left; }
    .roadmap-desktop { display: none; }
    .roadmap-mobile { display: block; }
    .roadmap-mobile > section { padding: 1rem; }
    .roadmap-mobile > section + section { border-top: 1px solid rgb(var(--roadmap-line)); }
    .roadmap-mobile > section > header h3 { margin: 0.25rem 0 0; font-size: 1.15rem; letter-spacing: 0.05em; }
    .roadmap-mobile > section > header > p:last-child { margin: 0.35rem 0 0; color: rgb(var(--roadmap-muted)); font-size: 0.72rem; line-height: 1.45; }
    .roadmap-mobile__items { display: grid; gap: 0.65rem; margin-top: 0.85rem; }
    .roadmap-watch__grid, .roadmap-context, .roadmap-legend__body { grid-template-columns: 1fr; }
    .roadmap-watch article + article { border-left: 0; }
    .roadmap-watch article:nth-child(n + 2) { margin-top: 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.12); }
    .roadmap-context { gap: 1px; }
  }
</style>
